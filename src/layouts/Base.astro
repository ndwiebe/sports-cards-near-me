---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/600.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import EcosystemFooter from '../components/EcosystemFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage, noindex } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Analytics + Search Console verification are all config-only: set an env var and
// it appears site-wide; leave it unset and nothing is emitted at all (no broken
// script tag, no empty meta). Set only the one(s) you actually want.
//
//   PUBLIC_GSC_VERIFICATION=<content= value from Search Console's HTML-tag method>
//   PUBLIC_CF_ANALYTICS_TOKEN=<token from Cloudflare Web Analytics>  free, no cookies
//   PUBLIC_GA4_ID=G-XXXXXXXXXX                                       free, Google's own
//   PUBLIC_PLAUSIBLE_DOMAIN=sportscardsnearme.ca                     paid alternative
//
// Cookie note: Cloudflare Web Analytics and Plausible set no cookies and need no
// consent banner. GA4 does set cookies — running it means PIPEDA/GDPR consent is
// Nathan's call, which is why it is opt-in here rather than assumed.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}
    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <header class="border-b border-bord/50">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-1 px-5 py-2.5 md:flex-nowrap md:py-4">
        <a href="/" class="flex items-center gap-2 font-display text-base uppercase tracking-wide max-[420px]:text-sm md:text-xl">
          <Mark size={26} />
          Sports Cards Near Me
        </a>
        <div class="flex w-full flex-wrap justify-end gap-x-4 gap-y-1 text-sm text-muted md:w-auto md:gap-x-5">
          <a href="/#browse" class="hover:text-paper">Browse</a>
          <a href="/shows/" class="hover:text-paper">Shows</a>
          <a href="/sell/" class="hover:text-paper">Sell</a>
          <a href="/resellers/" class="hover:text-paper">Resellers</a>
          <a href="/guides/" class="hover:text-paper">Guides</a>
          <a href="/about/" class="hover:text-paper">About</a>
          <a href="/suggest/" class="hover:text-paper">Suggest a store</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-5 pb-24">
      <slot />
    </main>
    <footer class="border-t border-bord/50 py-8 text-center text-sm text-muted">
      <EcosystemFooter />
      <p class="mt-8">
        © 2026 Sports Cards Near Me · Canada's card shop directory ·{' '}
        <a href="/about/" class="hover:text-paper">About &amp; corrections</a> ·{' '}
        <a href="/privacy/" class="hover:text-paper">Privacy</a>
      </p>
    </footer>
  </body>
</html>
