---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/600.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import EcosystemFooter from '../components/EcosystemFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage, noindex } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Analytics + Search Console verification are both config-only: set the env vars
// and they appear site-wide; leave them unset and nothing is emitted at all (no
// broken script tag, no empty meta). Plausible is privacy-first and needs no
// cookie banner, which is why it's the default shape here.
//   PUBLIC_PLAUSIBLE_DOMAIN=sportscardsnearme.ca
//   PUBLIC_GSC_VERIFICATION=<the content= value from Search Console's HTML-tag method>
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <header class="border-b border-bord/50">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-1 px-5 py-2.5 md:flex-nowrap md:py-4">
        <a href="/" class="flex items-center gap-2 font-display text-base uppercase tracking-wide max-[420px]:text-sm md:text-xl">
          <Mark size={26} />
          Sports Cards Near Me
        </a>
        <div class="flex w-full flex-wrap justify-end gap-x-4 gap-y-1 text-sm text-muted md:w-auto md:gap-x-5">
          <a href="/#browse" class="hover:text-paper">Browse</a>
          <a href="/shows/" class="hover:text-paper">Shows</a>
          <a href="/sell/" class="hover:text-paper">Sell</a>
          <a href="/resellers/" class="hover:text-paper">Resellers</a>
          <a href="/guides/" class="hover:text-paper">Guides</a>
          <a href="/suggest/" class="hover:text-paper">Suggest a store</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-5 pb-24">
      <slot />
    </main>
    <footer class="border-t border-bord/50 py-8 text-center text-sm text-muted">
      <EcosystemFooter />
      <p class="mt-8">© 2026 Sports Cards Near Me · Canada's card shop directory</p>
    </footer>
  </body>
</html>
