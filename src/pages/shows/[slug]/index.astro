---
import Base from '../../../layouts/Base.astro';
import showsJson from '../../../data/shows.json';
import type { ShowRecord, ShowSeries } from '../../../lib/shows';
import { groupShowsIntoSeries, isUpcoming, nextInSeries, parseLocalDate, showEventLd, showTimingLabel } from '../../../lib/shows';
import { absoluteUrl, ldJson } from '../../../lib/seo';
import { SHOW_FORM_URL } from '../../../lib/forms';
import { PROVINCES } from '../../../lib/types';

// Builds the series map once for the whole route rather than per-page, then
// hands each show its own series (if it has one) as a prop.
export function getStaticPaths() {
  const shows = showsJson as ShowRecord[];
  const seriesList = groupShowsIntoSeries(shows);
  const seriesByShowSlug = new Map<string, ShowSeries>();
  for (const series of seriesList) {
    for (const s of series.shows) seriesByShowSlug.set(s.slug, series);
  }
  return shows.map((s) => ({ params: { slug: s.slug }, props: { show: s, series: seriesByShowSlug.get(s.slug) } }));
}

interface Props { show: ShowRecord; series: ShowSeries | undefined }
const { show, series } = Astro.props;
const provinceName = PROVINCES[show.province].name;

const dateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' });
const startFormatted = dateFormat.format(parseLocalDate(show.startDate));
const endFormatted = show.endDate !== undefined ? dateFormat.format(parseLocalDate(show.endDate)) : undefined;
const dateRange = endFormatted !== undefined && endFormatted !== startFormatted ? `${startFormatted} – ${endFormatted}` : startFormatted;

// Every show query in the 07-23 keyword research carried a time modifier
// ("this weekend", "today", "2026"), so the title leads with one rather than
// the show name. undefined only for shows that already finished.
const buildDate = new Date();
const timingLabel = showTimingLabel(show, buildDate);
const upcoming = isUpcoming(show, buildDate);
const nextInSeriesShow = series !== undefined ? nextInSeries(series, buildDate) : undefined;
const nextDateFormatted = nextInSeriesShow !== undefined ? dateFormat.format(parseLocalDate(nextInSeriesShow.startDate)) : undefined;

const ld = showEventLd(show, absoluteUrl(Astro.site, `/shows/${show.slug}/`));
---
<Base
  title={timingLabel !== undefined
    ? `${timingLabel} — ${show.name} in ${show.city}, ${show.province}`
    : `${show.name} — ${show.city}, ${show.province} (Past Show)`}
  description={timingLabel === 'Today' || timingLabel === 'Tomorrow' || timingLabel === 'This Weekend'
    ? `${timingLabel}: ${show.name} in ${show.city}, ${provinceName} — ${dateRange}${show.venue !== undefined ? ` at ${show.venue}` : ''}. Hours, admission, and directions on this page.`
    : timingLabel !== undefined
      ? `${timingLabel} — ${show.name} in ${show.city}, ${provinceName}${show.venue !== undefined ? ` at ${show.venue}` : ''}. Hours, admission, and directions on this page.`
      : `${show.name} took place in ${show.city}, ${provinceName} on ${dateRange}. Venue, hours, and admission details are on this page.`}
>
  {/* Event structured data only for a show that hasn't happened yet. Once a
      show is past there's no honest "scheduled" claim left to make --
      schema.org's EventStatusType has no "already happened" value, and Google's
      own Event guidance is to stop publishing markup for events once they're
      over, not to leave EventScheduled sitting on a page a reader can no longer
      act on. showEventLd() itself is unchanged; this only gates rendering it. */}
  {upcoming && <script type="application/ld+json" set:html={ldJson(ld)} />}
  <nav class="mt-10 text-sm text-muted">
    <a href="/shows/" class="hover:text-paper">Shows</a> / {show.name}
  </nav>
  <h1 class="mt-3 text-5xl md:text-7xl">{show.name}</h1>
  <div class="refractor-rule mt-4 w-28"></div>
  <p class="mt-4 text-lg text-paper/85">{dateRange}</p>
  {!upcoming && (
    <div class="mt-4 max-w-prose rounded-xl border border-bord bg-panel p-4 text-sm text-paper/85">
      <p>This show has already happened.</p>
      {nextInSeriesShow !== undefined ? (
        <p class="mt-2">
          The next {series?.name} date is <a href={`/shows/${nextInSeriesShow.slug}/`} class="text-prizm">{nextDateFormatted}</a>.
        </p>
      ) : series !== undefined ? (
        <p class="mt-2">
          No upcoming {series.name} date is on the calendar yet. See{' '}
          <a href={`/shows/series/${series.slug}/`} class="text-prizm">every {series.name} date</a> tracked so far.
        </p>
      ) : (
        <p class="mt-2">
          See the <a href="/shows/" class="text-prizm">full show calendar</a> for what's coming up.
        </p>
      )}
    </div>
  )}
  {series !== undefined && (
    <p class="mt-4 max-w-prose text-sm text-muted">
      Part of a recurring series —{' '}
      <a href={`/shows/series/${series.slug}/`} class="text-prizm">see all {series.shows.length} {series.name} dates</a>.
    </p>
  )}
  <dl class="mt-8 grid max-w-2xl gap-4 text-sm">
    <div><dt class="font-semibold uppercase tracking-wide text-muted">Location</dt><dd class="mt-1">{show.city}, {provinceName}</dd></div>
    {show.venue !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Venue</dt><dd class="mt-1">{show.venue}</dd></div>}
    {show.address !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Address</dt><dd class="mt-1">{show.address}</dd></div>}
    {show.hours !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Hours</dt><dd class="mt-1">{show.hours}</dd></div>}
    {show.admission !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Admission</dt><dd class="mt-1">{show.admission}</dd></div>}
    {show.recurring !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Recurring</dt><dd class="mt-1">{show.recurring}</dd></div>}
    {show.organizer !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Organizer</dt><dd class="mt-1">{show.organizer}</dd></div>}
  </dl>
  <div class="mt-8 flex flex-wrap gap-3">
    {show.website !== undefined && <a href={show.website} target="_blank" rel="noopener" class="rounded-lg px-5 py-2.5 font-semibold text-ink" style="background:var(--gradient-refractor)">Website</a>}
    {show.sourceUrl !== undefined && <a href={show.sourceUrl} target="_blank" rel="noopener" class="rounded-lg border border-bord px-5 py-2.5 font-semibold hover:border-prizm">Source</a>}
  </div>
  {/* A promoter's problem is filling tables, not being listed. Where we hold a
      booking link, this is the only place on the site that helps them with it. */}
  {show.tableBooking !== undefined && (
    <section class="mt-12 rounded-2xl border border-bord p-6">
      <h2 class="text-2xl">Selling at this show?</h2>
      <p class="mt-2 text-sm text-paper/85">
        {show.organizer !== undefined ? `${show.organizer} takes` : 'The organizer takes'} table
        bookings for {show.name}. Tables at a busy show go early, so book ahead of the date.
      </p>
      <a
        href={show.tableBooking}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-block rounded-lg px-5 py-2.5 font-semibold text-ink"
        style="background:var(--gradient-refractor)"
      >Book a table</a>
    </section>
  )}
  <p class="mt-12 text-sm text-muted">
    Run a show, or know one we're missing?{' '}
    <a href={SHOW_FORM_URL} target="_blank" rel="noopener" class="text-prizm">Add it to the calendar</a> — it's free, and a person reviews every submission.
  </p>
</Base>
