---
import Base from '../../layouts/Base.astro';
import { SHOW_FORM_URL } from '../../lib/forms';
import showsJson from '../../data/shows.json';
import type { ShowRecord } from '../../lib/shows';
import { parseLocalDate, isUpcoming, groupShowsByMonth, showTimingLabel } from '../../lib/shows';
import { PROVINCES } from '../../lib/types';
import type { ProvinceCode } from '../../lib/types';

const shows = showsJson as ShowRecord[];

// Build-time snapshot — see the comment on isUpcoming() in src/lib/shows.ts
// for why "now" here means "when this static build ran", not "right now".
const buildDate = new Date();
const upcoming = shows.filter((s) => isUpcoming(s, buildDate));
const past = shows.filter((s) => !isUpcoming(s, buildDate)).reverse();
const monthGroups = groupShowsByMonth(upcoming);

// The 07-23 keyword research found every show query carries a time modifier,
// so the hub page names the very next show and, when it's imminent, leads
// the title with the same urgency word its own page uses.
const nextShow = [...upcoming].sort(
  (a, b) => parseLocalDate(a.startDate).getTime() - parseLocalDate(b.startDate).getTime(),
)[0];
const nextShowTiming = nextShow !== undefined ? showTimingLabel(nextShow, buildDate) : undefined;
const nextShowWhen =
  nextShowTiming === 'This Weekend' ? 'this weekend'
  : nextShowTiming === 'Today' ? 'today'
  : nextShowTiming === 'Tomorrow' ? 'tomorrow'
  : nextShowTiming !== undefined ? `on ${nextShowTiming}`
  : undefined;
const titleLead = nextShowTiming === 'This Weekend' || nextShowTiming === 'Today' || nextShowTiming === 'Tomorrow'
  ? nextShowTiming
  : undefined;

const dateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' });
const formatRange = (show: ShowRecord): string => {
  const start = dateFormat.format(parseLocalDate(show.startDate));
  if (show.endDate === undefined) return start;
  const end = dateFormat.format(parseLocalDate(show.endDate));
  return end === start ? start : `${start} – ${end}`;
};

// Derived, not hardcoded: three links were hardcoded here, so the province-year
// pages generated from new show data (Ontario 2027, and five others) were live
// and in the sitemap but linked from nowhere. Orphan pages don't earn rankings.
const provinceYearLinks = [...new Map(
  (showsJson as ShowRecord[])
    .filter((s) => PROVINCES[s.province as ProvinceCode] !== undefined)
    .map((s) => {
      const p = PROVINCES[s.province as ProvinceCode];
      const year = Number(s.startDate.slice(0, 4));
      return [`${p.slug}-${year}`, { href: `/shows/${p.slug}-${year}/`, label: `${p.name} ${year}`, year }] as const;
    }),
).values()].sort((a, b) => a.year - b.year || a.label.localeCompare(b.label));
---
<Base
  title={titleLead !== undefined
    ? `Card Shows ${titleLead} — ${upcoming.length} Listed Across Canada`
    : `${upcoming.length} Upcoming Card Shows in Canada — Updated Daily`}
  description={nextShow !== undefined
    ? `${upcoming.length} upcoming card shows across Canada. Next up: ${nextShow.name} in ${nextShow.city}, ${PROVINCES[nextShow.province].name}${nextShowWhen !== undefined ? `, ${nextShowWhen}` : ''}. Dates, venues, and admission for every listing.`
    : `Verified card shows across Canada — dates, venues, and admission for every listing. New shows added as they're confirmed.`}
>
  <p class="mt-14 text-xs font-semibold uppercase tracking-[0.14em] text-muted">Calendar</p>
  <h1 class="mt-2 text-5xl md:text-7xl">Card Shows</h1>
  <div class="refractor-rule mt-4 w-28"></div>
  <p class="mt-5 max-w-prose text-muted">
    Verified card shows across Canada — every listing checked against a public source.
    Run a show, or know one we're missing?
    <a href={SHOW_FORM_URL} target="_blank" rel="noopener" class="text-prizm">Add a show</a> — it's free, and a person reviews every submission.
  </p>

  <ul role="list" class="mt-6 flex flex-wrap gap-3">
    {[{ href: '/shows/this-weekend/', label: 'This weekend' }, ...provinceYearLinks].map((l) => (
      <li>
        <a href={l.href} class="rounded-full border border-bord px-4 py-1.5 text-sm text-muted transition-colors hover:border-prizm hover:text-paper">
          {l.label}
        </a>
      </li>
    ))}
  </ul>

  {upcoming.length === 0 ? (
    <p class="mt-8 max-w-prose text-muted">
      No upcoming shows listed yet — know one? <a href={SHOW_FORM_URL} target="_blank" rel="noopener" class="text-prizm">Suggest it</a>.
    </p>
  ) : (
    <div class="mt-10 space-y-10">
      {monthGroups.map((group) => (
        <section>
          <h2 class="text-3xl">{group.label}</h2>
          <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
            {group.shows.map((show) => (
              <li>
                <a
                  href={`/shows/${show.slug}/`}
                  class="block rounded-xl border border-bord bg-panel p-5 transition-transform duration-200 hover:-translate-y-0.5 hover:border-prizm"
                >
                  <h3 class="text-xl">{show.name}</h3>
                  <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
                  <p class="mt-1 text-sm text-muted">{show.city}, {PROVINCES[show.province].name}{show.venue !== undefined ? ` · ${show.venue}` : ''}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

  {past.length > 0 && (
    <details class="mt-16">
      <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-muted hover:text-paper">
        Past shows ({past.length})
      </summary>
      <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
        {past.map((show) => (
          <li>
            <a
              href={`/shows/${show.slug}/`}
              class="block rounded-xl border border-bord bg-panel p-5 hover:border-prizm"
            >
              <h3 class="text-xl">{show.name}</h3>
              <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
              <p class="mt-1 text-sm text-muted">{show.city}, {PROVINCES[show.province].name}</p>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</Base>
