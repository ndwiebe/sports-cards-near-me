---
import Base from '../../../layouts/Base.astro';
import showsJson from '../../../data/shows.json';
import type { ShowRecord } from '../../../lib/shows';
import { parseLocalDate, isUpcoming, groupShowsByMonth, showsInProvinceYear } from '../../../lib/shows';
import { PROVINCES } from '../../../lib/types';
import { absoluteUrl, breadcrumbListLd, itemListLd, ldJson } from '../../../lib/seo';

const PROVINCE_CODE = 'AB' as const;
const YEAR = 2026;
const province = PROVINCES[PROVINCE_CODE];
const pagePath = `/shows/${province.slug}-${YEAR}/`;

const shows = showsJson as ShowRecord[];
const yearShows = showsInProvinceYear(shows, PROVINCE_CODE, YEAR);
const cityCount = new Set(yearShows.map((s) => s.citySlug)).size;

// Build-time snapshot — see the comment on isUpcoming() in src/lib/shows.ts
// for why "now" here means "when this static build ran", not "right now".
const buildDate = new Date();
const upcoming = yearShows.filter((s) => isUpcoming(s, buildDate));
const past = yearShows.filter((s) => !isUpcoming(s, buildDate));
const monthGroups = groupShowsByMonth(upcoming);

const dateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' });
const formatRange = (show: ShowRecord): string => {
  const start = dateFormat.format(parseLocalDate(show.startDate));
  if (show.endDate === undefined) return start;
  const end = dateFormat.format(parseLocalDate(show.endDate));
  return end === start ? start : `${start} – ${end}`;
};

const title = `Card Shows in ${province.name} ${YEAR}`;
const description =
  yearShows.length > 0
    ? `${yearShows.length} sports card ${yearShows.length === 1 ? 'show' : 'shows'} in ${province.name} in ${YEAR} — dates, venues, and admission, tracked from public sources.`
    : `Sports card shows in ${province.name} in ${YEAR} — none confirmed yet on Sports Cards Near Me. Check back as our show calendar grows.`;

const capsule =
  yearShows.length > 0
    ? `Sports Cards Near Me tracks ${yearShows.length} sports card ${yearShows.length === 1 ? 'show' : 'shows'} in ${province.name} for ${YEAR}, across ${cityCount} ${cityCount === 1 ? 'city' : 'cities'}. ${upcoming.length > 0 ? `${upcoming.length} ${upcoming.length === 1 ? 'is' : 'are'} still upcoming.` : 'All of them have already taken place.'}`
    : `Sports Cards Near Me has no ${province.name} card shows confirmed for ${YEAR} yet. Our show calendar updates as new dates are verified — check back soon, or see what's on across the rest of Canada.`;

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: 'Shows', url: absoluteUrl(Astro.site, '/shows/') },
  { name: `${province.name} ${YEAR}`, url: absoluteUrl(Astro.site, pagePath) },
]);
const showListLd = itemListLd(
  yearShows.map((s) => ({ name: s.name, url: absoluteUrl(Astro.site, `/shows/${s.slug}/`) })),
);
---
<Base title={`${title} | Sports Cards Near Me`} description={description}>
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  {yearShows.length > 0 && <script type="application/ld+json" set:html={ldJson(showListLd)} />}

  <p class="mt-14 text-xs font-semibold uppercase tracking-[0.14em] text-muted">Show Calendar</p>
  <h1 class="mt-2 text-5xl md:text-7xl">{title}</h1>
  <div class="refractor-rule mt-4 w-28"></div>
  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>
  <p class="mt-3 text-sm text-muted">
    Looking for a specific weekend? See <a href="/shows/this-weekend/" class="text-prizm">card shows this weekend</a>,
    the full <a href="/shows/" class="text-prizm">Canada-wide show calendar</a>, or every shop in{' '}
    <a href={`/${province.slug}/`} class="text-prizm">{province.name}</a>.
  </p>

  {yearShows.length === 0 ? (
    <p class="mt-10 max-w-prose text-muted">
      No {province.name} shows are confirmed for {YEAR} yet — our calendar is actively growing. Run a show, or know
      of one we're missing?{' '}
      <a href="https://docs.google.com/forms/d/e/1FAIpQLScRyvOUWQCBNnQBIfdDU2MVkqfgM4uy9HsEz7Tf5bWYA7H3kQ/viewform" target="_blank" rel="noopener" class="text-prizm">Add it</a> — it's free, and a person reviews every submission.
    </p>
  ) : (
    <>
      {upcoming.length === 0 ? (
        <p class="mt-10 max-w-prose text-muted">
          No more {province.name} shows are on the {YEAR} calendar — every one we tracked for the year has already
          happened. See the full <a href="/shows/" class="text-prizm">Canada-wide show calendar</a> for what's
          upcoming elsewhere, or check back as next year's dates get added.
        </p>
      ) : (
        <div class="mt-10 space-y-10">
          {monthGroups.map((group) => (
            <section>
              <h2 class="text-3xl">{group.label}</h2>
              <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
                {group.shows.map((show) => (
                  <li>
                    <a
                      href={`/shows/${show.slug}/`}
                      class="block rounded-xl border border-bord bg-panel p-5 transition-transform duration-200 hover:-translate-y-0.5 hover:border-prizm"
                    >
                      <h3 class="text-xl">{show.name}</h3>
                      <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
                      <p class="mt-1 text-sm text-muted">
                        {show.city}, {PROVINCE_CODE}{show.venue !== undefined ? ` · ${show.venue}` : ''}
                        {show.admission !== undefined ? ` · ${show.admission}` : ''}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}

      {past.length > 0 && (
        <details class="mt-16">
          <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-muted hover:text-paper">
            Past {YEAR} shows ({past.length})
          </summary>
          <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
            {past.map((show) => (
              <li>
                <a href={`/shows/${show.slug}/`} class="block rounded-xl border border-bord bg-panel p-5 hover:border-prizm">
                  <h3 class="text-xl">{show.name}</h3>
                  <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
                  <p class="mt-1 text-sm text-muted">{show.city}, {PROVINCE_CODE}</p>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  )}

  <p class="mt-12 text-sm text-muted">
    Know of a {province.name} show we're missing? <a href="/suggest/" class="text-prizm">Suggest it</a>.
  </p>
</Base>
