---
import Base from '../../../layouts/Base.astro';
import { SHOW_FORM_URL } from '../../../lib/forms';
import showsJson from '../../../data/shows.json';
import type { ShowRecord } from '../../../lib/shows';
import { parseLocalDate, isUpcoming, groupShowsByMonth, showsInProvince, showTimingLabel, provinceShowsPath, MIN_SHOWS_TO_INDEX_PROVINCE_HUB } from '../../../lib/shows';
import { PROVINCES } from '../../../lib/types';
import type { ProvinceCode } from '../../../lib/types';
import { absoluteUrl, breadcrumbListLd, itemListLd, ldJson } from '../../../lib/seo';

// One evergreen calendar per province with any show on record. These replaced
// the per-year pages — see provinceShowsPath() for why, and redirects.json for
// the old URLs.
export function getStaticPaths() {
  const codes = new Set((showsJson as ShowRecord[]).map((s) => s.province as ProvinceCode));
  return [...codes]
    .filter((code) => PROVINCES[code] !== undefined)
    .map((code) => ({ params: { provinceHub: PROVINCES[code].slug }, props: { code } }));
}

const { code: PROVINCE_CODE } = Astro.props as { code: ProvinceCode };
const province = PROVINCES[PROVINCE_CODE];
const pagePath = provinceShowsPath(province.slug);

const shows = showsJson as ShowRecord[];
const provinceShows = showsInProvince(shows, PROVINCE_CODE);
const cityCount = new Set(provinceShows.map((s) => s.citySlug)).size;
const noindex = provinceShows.length < MIN_SHOWS_TO_INDEX_PROVINCE_HUB;

// Build-time snapshot — see the comment on isUpcoming() in src/lib/shows.ts
// for why "now" here means "when this static build ran", not "right now".
const buildDate = new Date();
const upcoming = provinceShows.filter((s) => isUpcoming(s, buildDate));
// Most recent first: the show that just happened is the one someone is most
// likely looking for.
const past = provinceShows.filter((s) => !isUpcoming(s, buildDate)).reverse();
const monthGroups = groupShowsByMonth(upcoming);

const dateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' });
const formatRange = (show: ShowRecord): string => {
  const start = dateFormat.format(parseLocalDate(show.startDate));
  if (show.endDate === undefined) return start;
  const end = dateFormat.format(parseLocalDate(show.endDate));
  return end === start ? start : `${start} – ${end}`;
};

// The title opens with the same words as the <h1>. The year pages led with
// the urgency word ("This Weekend — 72 Upcoming Card Shows in Ontario 2026")
// under an h1 of "Card Shows in Ontario 2026"; Google's title-link docs list a
// <title> that disagrees with the page's main heading as a reason to rewrite
// it, and the urgency lead was identical boilerplate across every hub and the
// national /shows/ page. The timing still rides along, after the part that
// says what the page is. upcoming is chronological, so upcoming[0] is soonest.
const nextShow = upcoming[0];
const nextTimingLabel = nextShow !== undefined ? showTimingLabel(nextShow, buildDate) : undefined;
// Same phrasing as the national /shows/ description.
const nextShowWhen =
  nextTimingLabel === 'This Weekend' ? 'this weekend'
  : nextTimingLabel === 'Today' ? 'today'
  : nextTimingLabel === 'Tomorrow' ? 'tomorrow'
  : nextTimingLabel !== undefined ? `on ${nextTimingLabel}`
  : undefined;
const h1 = `Card Shows in ${province.name}`;
const title =
  upcoming.length > 0
    ? `${h1} — ${upcoming.length} Upcoming${nextTimingLabel !== undefined ? `, Next: ${nextTimingLabel}` : ''}`
    : h1;
const description =
  nextShow !== undefined
    ? `${upcoming.length} upcoming sports card ${upcoming.length === 1 ? 'show' : 'shows'} in ${province.name}. Next up: ${nextShow.name} in ${nextShow.city}${nextShowWhen !== undefined ? `, ${nextShowWhen}` : ''}. Dates, venues, and admission, tracked from public sources.`
    : `Sports card shows in ${province.name} — none upcoming on Sports Cards Near Me right now. Past shows are listed below; new dates are added as they're verified.`;

const capsule =
  provinceShows.length > 0
    ? `Sports Cards Near Me tracks ${provinceShows.length} sports card ${provinceShows.length === 1 ? 'show' : 'shows'} in ${province.name}, across ${cityCount} ${cityCount === 1 ? 'city' : 'cities'}. ${upcoming.length > 0 ? `${upcoming.length} ${upcoming.length === 1 ? 'is' : 'are'} still upcoming.` : 'All of them have already taken place.'}`
    : `Sports Cards Near Me has no ${province.name} card shows confirmed yet.`;

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: 'Shows', url: absoluteUrl(Astro.site, '/shows/') },
  { name: province.name, url: absoluteUrl(Astro.site, pagePath) },
]);
const showListLd = itemListLd(
  provinceShows.map((s) => ({ name: s.name, url: absoluteUrl(Astro.site, `/shows/${s.slug}/`) })),
);
---
<Base title={`${title} | Sports Cards Near Me`} description={description} noindex={noindex}>
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  {provinceShows.length > 0 && <script type="application/ld+json" set:html={ldJson(showListLd)} />}

  <p class="mt-14 text-xs font-semibold uppercase tracking-[0.14em] text-muted">Show Calendar</p>
  <h1 class="mt-2 text-5xl md:text-7xl">{h1}</h1>
  <div class="refractor-rule mt-4 w-28"></div>
  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>
  <p class="mt-3 text-sm text-muted">
    Looking for a specific weekend? See <a href="/shows/this-weekend/" class="text-prizm">card shows this weekend</a>,
    the full <a href="/shows/" class="text-prizm">Canada-wide show calendar</a>, or every shop in{' '}
    <a href={`/${province.slug}/`} class="text-prizm">{province.name}</a>.
  </p>
  <p class="mt-2 text-sm text-muted">
    Run a show in {province.name}, or know one we're missing?{' '}
    <a href={SHOW_FORM_URL} target="_blank" rel="noopener" class="text-prizm">Add it</a> — it's free, and a person reviews every submission.
  </p>

  {provinceShows.length === 0 ? (
    <p class="mt-10 max-w-prose text-muted">
      No {province.name} shows are confirmed yet — our calendar is actively growing. Run a show, or know
      of one we're missing?{' '}
      <a href={SHOW_FORM_URL} target="_blank" rel="noopener" class="text-prizm">Add it</a> — it's free, and a person reviews every submission.
    </p>
  ) : (
    <>
      {upcoming.length === 0 ? (
        <p class="mt-10 max-w-prose text-muted">
          No upcoming {province.name} shows are on the calendar — every one we've tracked has already
          happened. See the full <a href="/shows/" class="text-prizm">Canada-wide show calendar</a> for what's
          upcoming elsewhere, or check back as new dates get added.
        </p>
      ) : (
        <div class="mt-10 space-y-10">
          {monthGroups.map((group) => (
            <section>
              <h2 class="text-3xl">{group.label}</h2>
              <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
                {group.shows.map((show) => (
                  <li>
                    <a
                      href={`/shows/${show.slug}/`}
                      class="block rounded-xl border border-bord bg-panel p-5 transition-transform duration-200 hover:-translate-y-0.5 hover:border-prizm"
                    >
                      <h3 class="text-xl">{show.name}</h3>
                      <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
                      <p class="mt-1 text-sm text-muted">
                        {show.city}, {PROVINCE_CODE}{show.venue !== undefined ? ` · ${show.venue}` : ''}
                        {show.admission !== undefined ? ` · ${show.admission}` : ''}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}

      {past.length > 0 && (
        <details class="mt-16">
          <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-muted hover:text-paper">
            Past {province.name} shows ({past.length})
          </summary>
          <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
            {past.map((show) => (
              <li>
                <a href={`/shows/${show.slug}/`} class="block rounded-xl border border-bord bg-panel p-5 hover:border-prizm">
                  <h3 class="text-xl">{show.name}</h3>
                  <p class="mt-1 text-sm text-muted">{formatRange(show)}</p>
                  <p class="mt-1 text-sm text-muted">{show.city}, {PROVINCE_CODE}</p>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  )}

</Base>
