---
import Base from '../../../layouts/Base.astro';
import MapIsland from '../../../components/MapIsland.astro';
import CrossLinkCallout from '../../../components/CrossLinkCallout.astro';
import storesJson from '../../../data/stores.json';
import closedStoresJson from '../../../data/stores-closed.json';
import type { Store } from '../../../lib/types';
import { PROVINCES } from '../../../lib/types';
import { absoluteUrl, breadcrumbListLd, storeTitle, faqPageLd, ldJson, storeAnswerCapsule, storeFaqs } from '../../../lib/seo';
import { sellPageExistsForCity } from '../../../lib/sell';
import { nearestStores } from '../../../lib/nearby';
import { relatedGuidesForStore } from '../../../lib/related-guides';
import { hasLogo } from '../../../lib/logos';
import { formatHoursByDay, parseStoreHours } from '../../../lib/store-hours';
import OpenNowBadge from '../../../components/OpenNowBadge.astro';

// Closed shops keep their page. Someone who searches the shop by name deserves to be
// told it has closed, rather than hitting a 404 that tells them nothing — and if the
// closure turns out to be wrong (Google reports moved and rebranded shops as closed
// too) nothing has to be un-deleted. They are absent from stores.json, so they appear
// in no listing, count, map or guide; this is the only route that reads them back in.
export function getStaticPaths() {
  const all = [...(storesJson as Store[]), ...(closedStoresJson as Store[])];
  return all.map((s) => ({ params: { slug: s.slug }, props: { store: s } }));
}

interface Props { store: Store }
const { store } = Astro.props;
const isClosed = store.status === 'closed';
const isOnlineOnly = store.status === 'online-only';
const provinceName = PROVINCES[store.province].name;
const provinceSlug = PROVINCES[store.province].slug;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${store.lat},${store.lng}`;

const nearby = nearestStores(storesJson as Store[], store);
const guides = relatedGuidesForStore(store);
const sellUrl = `/sell/${store.citySlug}/`;
const pokemonUrl = `/pokemon/${store.citySlug}/`;
const lowerTags = [...store.services, ...store.sports].map((t) => t.trim().toLowerCase());
const buysHere = lowerTags.includes('buys');
const tcgHere = lowerTags.includes('pokemon');

// Store pages earn the site's top impressions on shop-NAME queries, yet were
// the only major page type with no answer capsule and no FAQ. Both added.
const capsule = storeAnswerCapsule(store, provinceName);
const faqs = storeFaqs(store, provinceName, sellPageExistsForCity(storesJson as Store[], store.citySlug));

// One of the inbound-link sources the guides amendment calls for: a shop that
// lists grading services links straight to the grading comparison guide,
// which sits on page two despite earning the most reach of any page type.
const offersGrading = store.services.some((s) => s.toLowerCase() === 'grading services');
const faqLd = faqPageLd(faqs);
const openingHours = parseStoreHours(store.hours);
// Undefined for a shop whose hours don't come through as a full seven-day week --
// the raw line is rendered instead, rather than a week with a day missing.
const hoursRows = formatHoursByDay(store.hours);
const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: provinceName, url: absoluteUrl(Astro.site, `/${provinceSlug}/`) },
  { name: store.city, url: absoluteUrl(Astro.site, `/${provinceSlug}/${store.citySlug}/`) },
  { name: store.name, url: absoluteUrl(Astro.site, `/store/${store.slug}/`) },
]);

// "<shop> reviews" is a live query, so the rating belongs in the description
// where it shows in the result, not only on the page.
// Present tense ("what they carry") is a claim about a shop still trading, so a
// shop with no storefront gets its own description rather than the live one.
const description = isClosed
  ? `${store.name} in ${store.city}, ${provinceName} has permanently closed. Its last known address and details are kept here; see card shops still open in ${store.city}.`
  : isOnlineOnly
    ? `${store.name} has closed its ${store.city}, ${provinceName} storefront and now sells online only. Where to find them, and card shops still open in ${store.city}.`
    : store.rating !== undefined && store.reviewCount !== undefined
      ? `${store.name} in ${store.city}, ${provinceName} — ${store.rating} stars from ${store.reviewCount} Google reviews. Address, map, directions and what they carry.`
      : `${store.name} in ${store.city}, ${provinceName}: address, map, directions and what they carry.`;

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: store.name,
  address: { '@type': 'PostalAddress', streetAddress: store.address, addressLocality: store.city, addressRegion: store.province, addressCountry: 'CA' },
  geo: { '@type': 'GeoCoordinates', latitude: store.lat, longitude: store.lng },
  ...(store.phone !== undefined && { telephone: store.phone }),
  ...(store.website !== undefined && { url: store.website }),
  ...(store.rating !== undefined &&
    store.reviewCount !== undefined && {
      aggregateRating: { '@type': 'AggregateRating', ratingValue: store.rating, reviewCount: store.reviewCount },
    }),
  // The Hours string renders below for people; this is the same hours in the
  // form Google reads for "open now". Absent when a shop's hours don't parse
  // cleanly — see the all-or-nothing rule in store-hours.ts.
  ...(openingHours !== undefined && { openingHoursSpecification: openingHours }),
};
---
<Base
  title={storeTitle(store)}
  description={description}
  noindex={store.status !== undefined}
>
  {/* No Store schema for a closed or online-only shop. It asserts a walk-in
      address via aggregateRating and telephone, which are live-storefront
      signals — emitting them for a shop with no walk-in location tells Google
      the opposite of what the page says. */}
  {store.status === undefined && <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />}
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  <script type="application/ld+json" set:html={ldJson(faqLd)} />
  <nav class="mt-10 text-sm text-muted">
    <a href={`/${provinceSlug}/`} class="hover:text-paper">{provinceName}</a>{' / '}<a href={`/${provinceSlug}/${store.citySlug}/`} class="hover:text-paper">{store.city}</a>{' / '}{store.name}
  </nav>
  <div class="mt-3 flex items-center gap-4">
    {hasLogo(store.slug) && <img src={`/logos/${store.slug}.webp`} width="64" height="64" loading="lazy" alt="" class="h-16 w-16 shrink-0 rounded-xl border border-bord" />}
    <h1 class="text-5xl md:text-7xl">{store.name}</h1>
  </div>
  <div class="refractor-rule mt-4 w-28"></div>
  {isClosed && (
    <aside class="mt-6 max-w-2xl rounded-xl border border-bord bg-panel p-5" data-testid="closed-notice">
      <p class="font-display text-base uppercase tracking-wide text-gold">Permanently closed</p>
      <p class="mt-2 max-w-prose text-sm text-paper/85">
        This shop has closed. Its page is kept so the address and contact details stay findable,
        but it no longer appears in our listings for {store.city}.
      </p>
      <p class="mt-3 text-sm">
        <a href={`/${provinceSlug}/${store.citySlug}/`} class="text-prizm hover:underline">See card shops still open in {store.city} &rarr;</a>
      </p>
      <p class="mt-3 text-xs text-muted">
        Still trading, or did we get this wrong? <a href="/suggest/" class="text-prizm hover:underline">Tell us and we'll put it back</a>.
      </p>
    </aside>
  )}
  {isOnlineOnly && (
    <aside class="mt-6 max-w-2xl rounded-xl border border-bord bg-panel p-5" data-testid="online-only-notice">
      <p class="font-display text-base uppercase tracking-wide text-gold">No longer a walk-in storefront — now online only</p>
      <p class="mt-2 max-w-prose text-sm text-paper/85">
        {store.name} has closed its physical location in {store.city} and now sells online only. It's still a real,
        active business — just not one you can walk into — so it no longer appears in our walk-in listings for {store.city}.
      </p>
      {store.website !== undefined && (
        <p class="mt-3 text-sm">
          <a href={store.website} target="_blank" rel="noopener" class="text-prizm hover:underline">Shop online at {store.website.replace(/^https?:\/\//, '')} &rarr;</a>
        </p>
      )}
      <p class="mt-3 text-xs text-muted">
        Back to a physical location, or did we get this wrong? <a href="/suggest/" class="text-prizm hover:underline">Tell us and we'll update the listing</a>.
      </p>
    </aside>
  )}
  {store.status !== 'closed' && store.rating !== undefined && (
    <p class="mt-4 text-gold" data-testid="rating">
      ★ {store.rating}{store.reviewCount !== undefined && <span class="text-muted"> · {store.reviewCount} Google reviews</span>}
    </p>
  )}
  <OpenNowBadge store={store} />
  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>
  <dl class="mt-8 grid max-w-2xl gap-4 text-sm">
    <div><dt class="font-semibold uppercase tracking-wide text-muted">Address</dt><dd class="mt-1">{store.address}</dd></div>
    {store.hours !== undefined && (
      <div>
        <dt class="font-semibold uppercase tracking-wide text-muted">Hours</dt>
        <dd class="mt-1">
          {hoursRows === undefined ? store.hours : (
            <table class="w-full max-w-xs border-collapse text-sm">
              <tbody>
                {hoursRows.map((row) => (
                  <tr class="border-b border-bord/40 last:border-0">
                    <th scope="row" class="py-1.5 pr-4 text-left font-normal text-muted">{row.day}</th>
                    <td class={`py-1.5 text-right tabular-nums ${row.isClosed ? 'text-muted' : ''}`}>{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </dd>
      </div>
    )}
    {store.phone !== undefined && <div><dt class="font-semibold uppercase tracking-wide text-muted">Phone</dt><dd class="mt-1"><a href={`tel:${store.phone.replace(/[^0-9+]/g, '')}`} class="text-prizm" data-track-click="call" data-store-slug={store.slug}>{store.phone}</a></dd></div>}
  </dl>
  <div class="mt-8 max-w-2xl">
    <MapIsland stores={[store]} mode="store" height="300px" />
  </div>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href={directions} target="_blank" rel="noopener" class="rounded-lg px-5 py-2.5 font-semibold text-ink" style="background:var(--gradient-refractor)" data-track-click="directions" data-store-slug={store.slug}>Directions</a>
    {store.phone !== undefined && <a href={`tel:${store.phone.replace(/[^0-9+]/g, '')}`} class="rounded-lg border border-bord px-5 py-2.5 font-semibold hover:border-prizm" data-track-click="call" data-store-slug={store.slug}>Call</a>}
    {store.website !== undefined && <a href={store.website} target="_blank" rel="noopener" class="rounded-lg border border-bord px-5 py-2.5 font-semibold hover:border-prizm">Website</a>}
    {store.social !== undefined && <a href={store.social} target="_blank" rel="noopener" class="rounded-lg border border-bord px-5 py-2.5 font-semibold hover:border-prizm">Social</a>}
  </div>
  {(store.services.length > 0 || store.sports.length > 0) && (
    <ul role="list" class="mt-8 flex max-w-2xl flex-wrap gap-2">
      {[...store.services, ...store.sports].map((t) => (
        <li class="rounded-full border border-bord px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted">{t}</li>
      ))}
    </ul>
  )}
  {offersGrading && (
    <p class="mt-4 max-w-2xl text-sm text-muted">
      {store.name} lists card grading as a service — see our{' '}
      <a href="/guides/card-grading-companies-canada/" class="text-prizm">guide to Canada's grading companies</a> for
      how the major graders compare on cost and turnaround.
    </p>
  )}
  <section class="mt-16 max-w-2xl">
    <h2 class="text-3xl">Common questions</h2>
    <dl class="mt-6 grid gap-6">
      {faqs.map((faq) => (
        <div>
          <dt class="font-semibold">{faq.question}</dt>
          <dd class="mt-1.5 text-muted">
            {faq.answer}
            {faq.link !== undefined && (
              <>{' '}<a href={faq.link.href} class="text-prizm">{faq.link.label}</a>.</>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {nearby.length > 0 && (
    <section class="mt-16 max-w-2xl">
      <h2 class="text-3xl">More card shops near here</h2>
      <ul role="list" class="mt-6 grid gap-3">
        {nearby.map((s) => (
          <li>
            <a href={`/store/${s.slug}/`} class="font-semibold hover:text-prizm">{s.name}</a>
            <span class="text-sm text-muted"> · {s.city}{s.rating !== undefined && <> · ★ {s.rating}</>}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-muted">
        See every shop in{' '}
        <a href={`/${provinceSlug}/${store.citySlug}/`} class="text-prizm">{store.city}</a>, or browse all of{' '}
        <a href={`/${provinceSlug}/`} class="text-prizm">{provinceName}</a>.
      </p>
    </section>
  )}

  {(buysHere || tcgHere) && (
    <p class="mt-8 max-w-2xl text-sm text-muted">
      {buysHere && (
        <>
          {store.name} lists buying collections as a service — see{' '}
          <a href={sellUrl} class="text-prizm">every shop that buys in {store.city}</a>.{' '}
        </>
      )}
      {tcgHere && (
        <>
          It also carries trading card games — see{' '}
          <a href={pokemonUrl} class="text-prizm">Pokémon and TCG shops in {store.city}</a>.
        </>
      )}
    </p>
  )}

  <section class="mt-12 max-w-2xl">
    <h2 class="text-3xl">Guides for collectors</h2>
    <ul role="list" class="mt-6 grid gap-4">
      {guides.map((g) => (
        <li>
          <a href={`/guides/${g.slug}/`} class="font-semibold hover:text-prizm">{g.title}</a>
          <p class="mt-1 text-sm text-muted">{g.dek}</p>
        </li>
      ))}
    </ul>
  </section>

  <CrossLinkCallout
    heading="Taking cards in to sell or trade?"
    body="Sharp photos make a card easier to price and to list. DisplayMyCard is my own tool — it has no bearing on how any shop is ranked here."
    links={[{ label: 'Enhance your card photos →', href: 'https://displaymycard.com', external: true }]}
  />

  <p class="mt-12 text-sm text-muted">
    Own this shop? <a href="/suggest/" class="text-prizm">Claim or update your listing</a>.
  </p>
</Base>
