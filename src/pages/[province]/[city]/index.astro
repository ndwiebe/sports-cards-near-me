---
import Base from '../../../layouts/Base.astro';
import StoreCard from '../../../components/StoreCard.astro';
import MapIsland from '../../../components/MapIsland.astro';
import storesJson from '../../../data/stores.json';
import resellersJson from '../../../data/resellers.json';
import type { Store } from '../../../lib/types';
import type { ResellerRecord } from '../../../lib/resellers';
import { provincesWithStores, citiesIn, provinceBySlug } from '../../../lib/stores';
import { toMapResellers } from '../../../lib/map-data';
import { absoluteUrl, breadcrumbListLd, cityAnswerCapsule, cityFaqs, faqPageLd, itemListLd, ldJson, rankedFirstPhrase, topRatedStore, MIN_REVIEWS_FOR_TOP } from '../../../lib/seo';
import showsJson from '../../../data/shows.json';
import type { ShowRecord } from '../../../lib/shows';
import { isUpcoming, parseLocalDate, primaryShowCalendarYear } from '../../../lib/shows';
import { nearestCities, nearestStoresToCity } from '../../../lib/nearby';
import { relatedGuidesForCity } from '../../../lib/related-guides';

const THIN_CITY_SHOP_COUNT = 1;
const NEARBY_SHOP_LIMIT = 5;
const UPCOMING_SHOW_LIMIT = 5;

export function getStaticPaths() {
  const stores = storesJson as Store[];
  return provincesWithStores(stores).flatMap((p) =>
    citiesIn(stores, p.code).map((c) => ({ params: { province: p.slug, city: c.citySlug } })),
  );
}

const stores = storesJson as Store[];
const province = provinceBySlug(Astro.params.province);
if (!province) throw new Error(`unknown province slug: ${Astro.params.province}`);
const cityGroup = citiesIn(stores, province.code).find((c) => c.citySlug === Astro.params.city);
if (!cityGroup) throw new Error(`unknown city slug: ${Astro.params.city}`);
const services = [...new Set(cityGroup.stores.flatMap((s) => s.services))].sort();
const sports = [...new Set(cityGroup.stores.flatMap((s) => s.sports))].sort();

// Same-province filter is load-bearing: nearestCities ranks across the whole
// country, so a border city can return a neighbour in another province — and
// the link below is built with THIS page's province.slug, which would 404.
const nearbyCities = nearestCities(stores, province.code, cityGroup.citySlug).filter((c) => c.province === province.code);
const nearbyStores = cityGroup.stores.length === THIN_CITY_SHOP_COUNT
  ? nearestStoresToCity(stores, province.code, cityGroup.citySlug, { limit: NEARBY_SHOP_LIMIT })
  : [];
const cityGuides = relatedGuidesForCity(cityGroup.stores, province.code, cityGroup.citySlug);
const shows = showsJson as ShowRecord[];
const buildDate = new Date();
const upcomingProvinceShows = shows
  .filter((show) => show.province === province.code && isUpcoming(show, buildDate))
  .sort((a, b) => parseLocalDate(a.startDate).getTime() - parseLocalDate(b.startDate).getTime())
  .slice(0, UPCOMING_SHOW_LIMIT);
const showDateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' });
const showYear = primaryShowCalendarYear(shows, province.code, buildDate);
const showsUrl = showYear !== undefined ? `/shows/${province.slug}-${showYear}/` : '/shows/';
const cityLowerTags = [...services, ...sports].map((t) => t.trim().toLowerCase());
const cityBuys = cityLowerTags.includes('buys');
const cityTcg = cityLowerTags.includes('pokemon');

const cityResellers = (resellersJson as ResellerRecord[]).filter(
  (r) => r.province === province.code && r.citySlug === cityGroup.citySlug,
);
const resellerPins = toMapResellers(cityResellers, cityGroup.stores);

const provinceUrl = absoluteUrl(Astro.site, `/${province.slug}/`);
const cityUrl = absoluteUrl(Astro.site, `/${province.slug}/${cityGroup.citySlug}/`);
const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: province.name, url: provinceUrl },
  { name: cityGroup.city, url: cityUrl },
]);
const storeListLd = itemListLd(
  cityGroup.stores.map((s) => ({ name: s.name, url: absoluteUrl(Astro.site, `/store/${s.slug}/`) })),
  25,
);
const capsule = cityAnswerCapsule(cityGroup.city, province.name, cityGroup.stores);

// "Best card shops in [city]" is the highest-commercial-intent format in the
// keyword research, and it only became honest once ratings coverage reached
// 92%. topRatedStore returns undefined where nothing clears the review bar
// (54 of 248 cities), and those cities get no claim at all rather than a
// weaker one — same rule as the shop pages: no empty scaffolding.
const topRated = topRatedStore(cityGroup.stores);

// The title must not promise something the page can't show. 57 city pages were
// titled "Rated & Mapped" while carrying no rated shop at all — a claim the
// page fails to deliver, and the click-then-bounce that follows is the opposite
// of the CTR work this title exists for. "Rated" only when a rating is visible;
// no "Rated"/"Ranked" language for a lone shop, which cannot be ranked.
const anyRated = cityGroup.stores.some((s) => s.rating !== undefined);
const titleSuffix = cityGroup.stores.length === 1
  ? 'Address, Map & Directions'
  : anyRated
    ? 'Rated & Mapped, Updated Daily'
    : 'Address, Map & Directions, Updated Daily';

const faqs = cityFaqs(cityGroup.city, province.name, provinceUrl, cityGroup.stores, cityGroup.citySlug);
const faqLd = faqPageLd(faqs);
---
<Base
  title={`${cityGroup.stores.length} Card Shop${cityGroup.stores.length === 1 ? '' : 's'} in ${cityGroup.city}, ${province.code} — ${titleSuffix}`}
  description={topRated !== undefined && topRated.rating !== undefined
    ? `All ${cityGroup.stores.length} card shops in ${cityGroup.city}, ${province.name} — Google ratings, map and directions, rebuilt daily. ${rankedFirstPhrase(topRated)}.`
    : `Every sports card shop in ${cityGroup.city}, ${province.name} — compare ratings where they exist, map and directions. Rebuilt daily so listings stay current.`}
>
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  <script type="application/ld+json" set:html={ldJson(storeListLd)} />
  <script type="application/ld+json" set:html={ldJson(faqLd)} />
  <section class="relative mt-6 overflow-hidden rounded-2xl border border-bord">
    <img
      src="/images/city-generic.webp"
      srcset="/images/city-generic@900.webp 900w, /images/city-generic.webp 1600w"
      sizes="(max-width: 900px) 100vw, 1024px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/25"></div>
    <div class="relative px-6 py-10 md:px-12 md:py-14">
      <nav class="text-sm text-muted"><a href={`/${province.slug}/`} class="hover:text-paper">{province.name}</a> / {cityGroup.city}</nav>
      <h1 class="mt-3 text-5xl md:text-7xl">Sports Card Shops in {cityGroup.city}</h1>
      <div class="refractor-rule mt-4 w-28"></div>
      <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>
      {topRated !== undefined && (
        <p class="mt-4 text-sm text-muted" data-ranks-first>
          Ranks first:{' '}
          <a href={`/store/${topRated.slug}/`} class="font-semibold text-prizm">{topRated.name}</a>
          {topRated.rating !== undefined && (
            <span> — {topRated.rating} stars from {topRated.reviewCount} Google reviews</span>
          )}. Ordered by rating weighted for review volume, among shops with {MIN_REVIEWS_FOR_TOP}+ reviews — so this is
          not simply the highest star average. Nobody pays for a place in this ranking.
        </p>
      )}
    </div>
  </section>

  <div class="mt-8 flex flex-col gap-3" data-filterbar>
    <input
      type="search"
      placeholder={`Search ${cityGroup.city} shops…`}
      class="w-full max-w-md rounded-lg border border-bord bg-well px-4 py-2.5 text-sm text-paper placeholder:text-faint"
      data-filter-search
    />
    {(services.length > 0 || sports.length > 0) && (
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter stores">
        {[...services, ...sports].map((t) => (
          <button
            type="button"
            class="rounded-full border border-bord px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted hover:border-prizm aria-pressed:border-prizm aria-pressed:text-paper"
            data-filter-tag={t}
            aria-pressed="false"
          >{t}</button>
        ))}
      </div>
    )}
    <p class="text-sm text-muted"><span data-results-count>{cityGroup.stores.length}</span> shown</p>
  </div>

  <div class="mt-4 flex gap-2 md:hidden">
    <button type="button" class="flex-1 rounded-lg border border-prizm px-4 py-2 text-sm font-semibold" data-view="list" aria-pressed="true">List</button>
    <button type="button" class="flex-1 rounded-lg border border-bord px-4 py-2 text-sm font-semibold text-muted" data-view="map" aria-pressed="false">Map</button>
  </div>

  <div class="mt-4 grid gap-6 md:grid-cols-[1fr_1fr]" data-city-layout>
    <ul role="list" class="space-y-4" data-store-list>
      {cityGroup.stores.map((store) => <StoreCard store={store} />)}
    </ul>
    <div data-city-map class="max-md:hidden md:sticky md:top-6 md:self-start">
      <MapIsland stores={cityGroup.stores} extra={resellerPins} mode="city" height="560px" />
    </div>
  </div>

  {nearbyStores.length > 0 && (
    <section class="mt-12">
      <h2 class="text-3xl">Nearby shops</h2>
      <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
        {nearbyStores.map((store) => <StoreCard store={store} />)}
      </ul>
    </section>
  )}

  {cityResellers.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl">Verified resellers in {cityGroup.city}</h2>
      <p class="mt-1 text-sm text-muted">Trusted sellers here without a storefront — sold online, checked by a human.</p>
      <ul role="list" class="mt-4 grid gap-4 sm:grid-cols-2">
        {cityResellers.map((r) => (
          <li>
            <a href={`/resellers/${r.slug}/`} data-reseller-card={r.slug}
              class="flex items-center justify-between rounded-xl border border-bord bg-panel p-4 hover:border-prizm">
              <span class="font-semibold">{r.name}</span>
              <span class="rounded-full border border-gold/60 bg-well px-2.5 py-0.5 text-xs font-semibold text-gold">SCNM Verified</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-12">
    <h2 class="text-3xl">Upcoming card shows in {province.name}</h2>
    {upcomingProvinceShows.length > 0 ? (
      <ul role="list" class="mt-6 grid gap-3 sm:grid-cols-2">
        {upcomingProvinceShows.map((show) => (
          <li>
            <a href={`/shows/${show.slug}/`} class="block rounded-xl border border-bord bg-panel p-4 hover:border-prizm">
              <span class="font-semibold">{show.name}</span>
              <span class="block text-sm text-muted">
                {show.city}, {show.province} · {showDateFormat.format(parseLocalDate(show.startDate))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-muted">No upcoming shows are confirmed in {province.name} yet.</p>
    )}
  </section>

  <section class="mt-12">
    <h2 class="text-2xl">FAQ</h2>
    <dl class="mt-4 space-y-6">
      {faqs.map((faq) => (
        <div>
          <dt class="font-semibold">{faq.question}</dt>
          <dd class="mt-1 max-w-prose text-muted">
            {faq.answer}
            {faq.link !== undefined && (
              <>
                {' '}
                <a href={faq.link.href} class="text-prizm">{faq.link.label}</a>
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 text-sm text-muted">Directory data refreshed daily.</p>
  </section>

  <section class="mt-16">
    <h2 class="text-3xl">Keep looking</h2>
    <ul role="list" class="mt-6 grid gap-2 sm:grid-cols-2">
      {cityBuys && (
        <li>
          <a href={`/sell/${cityGroup.citySlug}/`} class="font-semibold hover:text-prizm">
            Shops that buy collections in {cityGroup.city}
          </a>
        </li>
      )}
      {cityTcg && (
        <li>
          <a href={`/pokemon/${cityGroup.citySlug}/`} class="font-semibold hover:text-prizm">
            Pokémon &amp; TCG shops in {cityGroup.city}
          </a>
        </li>
      )}
      <li>
        <a href={showsUrl} class="font-semibold hover:text-prizm">
          Card shows in {province.name}{showYear !== undefined ? ` ${showYear}` : ''}
        </a>
      </li>
      <li>
        <a href={`/${province.slug}/`} class="font-semibold hover:text-prizm">
          Every card shop in {province.name}
        </a>
      </li>
    </ul>
  </section>

  {nearbyCities.length > 0 && (
    <section class="mt-12">
      <h2 class="text-3xl">Nearby cities</h2>
      <ul role="list" class="mt-6 flex flex-wrap gap-2">
        {nearbyCities.map((c) => (
          <li>
            <a
              href={`/${province.slug}/${c.citySlug}/`}
              class="inline-block rounded-full border border-bord px-3 py-1 text-sm hover:border-prizm"
            >{c.city} <span class="text-muted">({c.count})</span></a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-12 max-w-2xl">
    <h2 class="text-3xl">Guides for collectors</h2>
    <ul role="list" class="mt-6 grid gap-4">
      {cityGuides.map((g) => (
        <li>
          <a href={`/guides/${g.slug}/`} class="font-semibold hover:text-prizm">{g.title}</a>
          <p class="mt-1 text-sm text-muted">{g.dek}</p>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import { whenMapReady } from '../../../scripts/map-registry';
    import type { MapHandle } from '../../../scripts/map-core';
    import type { MapStore } from '../../../lib/map-data';

    const layout = document.querySelector<HTMLElement>('[data-city-layout]');
    const list = document.querySelector<HTMLElement>('[data-store-list]');
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    const tags = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
    const count = document.querySelector<HTMLElement>('[data-results-count]');
    let handle: MapHandle | null = null;

    const mapShell = document.querySelector<HTMLElement>('[data-city-map] .map-shell');
    const raw = mapShell?.querySelector('script[data-map-stores]')?.textContent ?? '[]';
    const all = JSON.parse(raw) as MapStore[];

    if (mapShell) {
      whenMapReady(mapShell, (h) => {
        handle = h;
        wireHover();
        // The map mounts lazily — re-apply any filtering done before it was
        // ready, or it would open showing the full unfiltered pin set.
        apply();
      });
    }

    function activeTags(): string[] {
      return tags.filter((t) => t.getAttribute('aria-pressed') === 'true').map((t) => t.dataset['filterTag'] ?? '');
    }

    function apply(): void {
      const q = (search?.value ?? '').toLowerCase();
      const need = activeTags();
      const visible = new Set<string>();
      for (const s of all) {
        if (s.kind === 'reseller') continue;
        const hay = `${s.name} ${s.city}`.toLowerCase();
        const tagPool = [...s.services, ...s.sports];
        const ok = hay.includes(q) && need.every((n) => tagPool.includes(n));
        if (ok) visible.add(s.slug);
      }
      for (const card of list?.querySelectorAll<HTMLElement>('[data-store-card]') ?? []) {
        card.classList.toggle('hidden', !visible.has(card.dataset['storeCard'] ?? ''));
      }
      if (count) count.textContent = String(visible.size);
      handle?.setStores([...all.filter((s) => s.kind !== 'reseller' && visible.has(s.slug)), ...all.filter((s) => s.kind === 'reseller')]);
    }

    search?.addEventListener('input', apply);
    for (const t of tags) {
      t.addEventListener('click', () => {
        t.setAttribute('aria-pressed', t.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }

    function wireHover(): void {
      for (const card of list?.querySelectorAll<HTMLElement>('[data-store-card]') ?? []) {
        card.addEventListener('mouseenter', () => handle?.highlight(card.dataset['storeCard'] ?? null));
        card.addEventListener('mouseleave', () => handle?.highlight(null));
      }
    }

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-view]')) {
      btn.addEventListener('click', () => {
        const view = btn.dataset['view'];
        for (const b of document.querySelectorAll<HTMLButtonElement>('[data-view]')) {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          b.classList.toggle('border-prizm', b === btn);
          b.classList.toggle('text-muted', b !== btn);
        }
        layout?.querySelector('[data-store-list]')?.classList.toggle('max-md:hidden', view === 'map');
        layout?.querySelector('[data-city-map]')?.classList.toggle('max-md:hidden', view === 'list');
      });
    }
  </script>
</Base>
