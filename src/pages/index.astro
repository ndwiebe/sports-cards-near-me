---
import Base from '../layouts/Base.astro';
import storesJson from '../data/stores.json';
import type { Store } from '../lib/types';
import { provincesWithStores, citiesIn } from '../lib/stores';
import MapIsland from '../components/MapIsland.astro';

const stores = storesJson as Store[];
const provinces = provincesWithStores(stores);
const featuredCities = provinces.flatMap((p) =>
  citiesIn(stores, p.code).map((c) => ({ ...c, provinceSlug: p.slug, provinceCode: p.code })),
).sort((a, b) => b.stores.length - a.stores.length).slice(0, 8);
---
<Base
  title="Sports Cards Near Me — Every Card Shop in Canada, One Map"
  description={`Canada's sports card shop directory: ${stores.length} verified stores with hours, ratings, and directions. Hockey, baseball, basketball, football, Pokémon.`}
>
  <section class="relative mt-6 overflow-hidden rounded-2xl border border-bord">
    <img
      src="/images/hero.webp"
      srcset="/images/hero@900.webp 900w, /images/hero.webp 1600w"
      sizes="(max-width: 900px) 100vw, 1024px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/20"></div>
    <div class="relative px-6 py-16 md:px-12 md:py-24">
      <h1 class="max-w-3xl text-6xl md:text-8xl">Every card shop in Canada. One map.</h1>
      <div class="refractor-rule mt-5 w-32"></div>
      <p class="mt-5 max-w-xl text-lg text-paper/85">
        {stores.length} shops — verified, mapped, and up to date. Find your next hit.
      </p>
      <button type="button" class="mt-6 inline-flex items-center rounded-lg px-6 py-3 font-semibold text-ink" style="background:var(--gradient-refractor)" data-geolocate>
        Find shops near me
      </button>
    </div>
  </section>

  <section id="map-slot" class="mt-12">
    <MapIsland stores={stores} mode="home" height="520px" />
    <div class="mt-4 flex flex-wrap items-center gap-2" data-city-flyto>
      <span class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">Fly to:</span>
      {featuredCities.map((c) => (
        <button
          type="button"
          class="rounded-full border border-bord px-3 py-1 text-sm text-muted hover:border-prizm hover:text-paper"
          data-fly={`${(c.stores.reduce((n, s) => n + s.lng, 0) / c.stores.length).toFixed(5)},${(c.stores.reduce((n, s) => n + s.lat, 0) / c.stores.length).toFixed(5)}`}
        >{c.city}</button>
      ))}
      <button type="button" class="rounded-full border border-bord px-3 py-1 text-sm text-prizm hover:border-prizm" data-geolocate>
        Find shops near me
      </button>
    </div>
    <div class="mt-6 hidden" data-nearest>
      <h2 class="text-2xl">Closest to you</h2>
      <ol role="list" class="mt-3 grid gap-2 sm:grid-cols-2" data-nearest-list></ol>
    </div>
  </section>
  <script>
    import { whenMapReady } from '../scripts/map-registry';
    import type { MapHandle } from '../scripts/map-core';
    import { distanceKm } from '../lib/map-data';
    import type { MapStore } from '../lib/map-data';

    const slot = document.getElementById('map-slot');
    const shell = slot?.querySelector<HTMLElement>('.map-shell');
    if (slot && shell) {
      whenMapReady(shell, (handle: MapHandle) => {
        for (const btn of slot.querySelectorAll<HTMLButtonElement>('[data-fly]')) {
          btn.addEventListener('click', () => {
            const [lng, lat] = (btn.dataset['fly'] ?? '0,0').split(',').map(Number);
            if (lng !== undefined && lat !== undefined) handle.flyTo(lng, lat, 12.5);
          });
        }
        for (const geoBtn of document.querySelectorAll<HTMLButtonElement>('[data-geolocate]')) {
          geoBtn.addEventListener('click', () => {
            slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
            navigator.geolocation.getCurrentPosition(
              (pos) => {
                handle.flyTo(pos.coords.longitude, pos.coords.latitude, 11.5);
                showNearest(pos.coords.latitude, pos.coords.longitude);
              },
              () => window.alert('Location unavailable — pick a city instead.'),
            );
          });
        }
      });
    }

    function showNearest(lat: number, lng: number): void {
      const raw = document.querySelector('script[data-map-stores]')?.textContent ?? '[]';
      const all = JSON.parse(raw) as MapStore[];
      const box = slot?.querySelector<HTMLElement>('[data-nearest]');
      const list = slot?.querySelector<HTMLElement>('[data-nearest-list]');
      if (!box || !list) return;
      list.textContent = '';
      const nearest = all
        .map((s) => ({ s, d: distanceKm(lat, lng, s.lat, s.lng) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, 6);
      for (const { s, d } of nearest) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/store/${s.slug}/`;
        a.className = 'flex items-center justify-between gap-3 rounded-xl border border-bord bg-panel px-4 py-3 hover:border-prizm';
        const name = document.createElement('span');
        name.className = 'font-semibold';
        name.textContent = s.name;
        const meta = document.createElement('span');
        meta.className = 'shrink-0 text-sm text-muted';
        meta.textContent = `${s.city} · ${d < 10 ? d.toFixed(1) : String(Math.round(d))} km`;
        a.append(name, meta);
        li.appendChild(a);
        list.appendChild(li);
      }
      box.classList.remove('hidden');
    }
  </script>

  <section class="mt-16">
    <h2 class="text-3xl">Busiest cities</h2>
    <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {featuredCities.map((c) => (
        <li>
          <a href={`/${c.provinceSlug}/${c.citySlug}/`} class="block rounded-xl border border-bord bg-panel p-4 hover:border-prizm">
            <span class="font-display text-xl uppercase">{c.city}</span>
            <span class="block text-sm text-muted">{c.stores.length} shops</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="text-3xl">Browse by province</h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {provinces.map((p) => (
        <li><a href={`/${p.slug}/`} class="rounded-full border border-bord px-4 py-2 text-sm hover:border-prizm">{p.name} · {p.count}</a></li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-muted">More provinces are being verified now — Canada-wide coverage is on the way.</p>
  </section>
</Base>
