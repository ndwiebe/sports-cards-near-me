---
import { byRecommendedRank } from '../../lib/seo';
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import CrossLinkCallout from '../../components/CrossLinkCallout.astro';
import storesJson from '../../data/stores.json';
import type { Store } from '../../lib/types';
import { PROVINCES } from '../../lib/types';
import { absoluteUrl, breadcrumbListLd, faqPageLd, ldJson, type FaqItem } from '../../lib/seo';

const stores = storesJson as Store[];
const cityCount = new Set(stores.map((s) => s.citySlug)).size;
const buyerCount = stores.filter((s) => s.services.some((v) => v.toLowerCase() === 'buys')).length;

// Shops that list buying collections among what they offer — computed from
// stores.json (case-insensitive match), deduped to one shop per city so the
// three examples aren't all pulled from the same town. Sorted by rating
// (undefined last) then review count, same tiebreak as our other guides, so
// this tracks the directory's live data.
const buyingStores: Store[] = [];
const seenBuyingCities = new Set<string>();
for (const s of stores
  .filter((s) => s.services.some((v) => v.toLowerCase() === 'buys'))
  .sort(byRecommendedRank)) {
  if (seenBuyingCities.has(s.citySlug)) continue;
  seenBuyingCities.add(s.citySlug);
  buyingStores.push(s);
  if (buyingStores.length === 3) break;
}

const title = "Selling a Collection You Inherited (or Outgrew)";
const description =
  'A Canadian collector’s guide to triaging an inherited or long-untouched card collection — what to check, which selling option fits your effort and timeline, and when grading first is worth it.';
const pagePath = '/guides/selling-your-collection/';

const capsule =
  "Sort a collection before you sell it: age, who's on the card, and condition are the three things that move value. A local shop sale is fastest but pays least; consignment and selling it yourself net more but take longer. A card worth real money is usually worth grading first — check the value gap before you decide.";

const faqs: FaqItem[] = [
  {
    question: 'How do I know if an inherited card collection is worth anything?',
    answer:
      "Age, who's on the card, and condition move the needle most. Genuinely vintage cards, star players and rookie cards, and anything with sharp corners and no creases are worth a closer look. Most of any collection is still just cards — but it's worth ten minutes of sorting before assuming the whole box is worthless.",
  },
  {
    question: 'What is the fastest way to sell a card collection?',
    answer:
      buyerCount > 0
        ? `A local shop sale is the least effort by far — walk in, get an on-the-spot offer, walk out with cash the same day. It typically pays less than consignment or selling it yourself, since the shop still has to resell it. ${buyerCount} shops in our directory list buying collections as a service.`
        : 'A local shop sale is the least effort by far — walk in, get an on-the-spot offer, walk out with cash the same day. It typically pays less than consignment or selling it yourself, since the shop still has to resell it.',
    link: { href: '/sell/', label: 'Find a shop that buys near you' },
  },
  {
    question: 'Should I get cards graded before selling a collection?',
    answer:
      "Only the ones that clear a real value bar — grading costs money and takes time, and it only pays off when the gap between raw and graded value covers that cost. Our card grading 101 guide walks through how to decide which cards, if any, are worth it.",
    link: { href: '/guides/card-grading-101/', label: 'How to decide if a card is worth grading' },
  },
  {
    question: 'Why do sight-unseen bulk offers for a whole collection run low?',
    answer:
      "Because the buyer has no way to know what's actually in the box until they sort it themselves, so a flat offer is priced for the worst realistic case. Sorting it yourself first and pulling out anything that clears the value bar usually nets more in total than one lump-sum offer for everything unseen.",
  },
];

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: 'Guides', url: absoluteUrl(Astro.site, '/guides/') },
  { name: title, url: absoluteUrl(Astro.site, pagePath) },
]);
const faqLd = faqPageLd(faqs);

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL('/images/guide-selling-your-collection.webp', Astro.site).href,
  datePublished: '2026-07-11',
  dateModified: '2026-07-11',
  author: {
    '@type': 'Person',
    name: 'Nathan Wiebe',
    jobTitle: 'Chartered Professional Accountant',
    url: new URL('/about/', Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: 'Sports Cards Near Me' },
};
---
<Base title={`${title} | Sports Cards Near Me`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  <script type="application/ld+json" set:html={ldJson(faqLd)} />

  <section class="relative mt-6 overflow-hidden rounded-2xl border border-bord bg-panel">
    <img
      src="/images/guide-selling-your-collection.webp"
      srcset="/images/guide-selling-your-collection@900.webp 900w, /images/guide-selling-your-collection.webp 1600w"
      sizes="(max-width: 900px) 100vw, 1024px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/25"></div>
    <div class="relative px-6 py-10 md:px-12 md:py-14">
      <nav class="text-sm text-muted"><a href="/guides/" class="hover:text-paper">Guides</a> / {title}</nav>
      <h1 class="mt-3 text-5xl md:text-7xl">{title}</h1>
      <div class="refractor-rule mt-4 w-28"></div>
  <Byline published="2026-07-11" modified="2026-07-11" />
    </div>
  </section>

  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>

  <div class="mt-10 max-w-prose space-y-6 text-paper/90">
    <p>
      A shoebox from a parent's closet, a binder from your own childhood, a collection someone left behind — sooner
      or later, most people end up holding a stack of cards they don't know the value of. The honest answer is that
      most of it is probably just cards: fun to flip through, not worth much on their own. But "most" isn't "all,"
      and it's worth ten minutes of sorting before you assume the whole box is worthless, or before you accept the
      first offer someone makes for it sight unseen. This guide walks through how to tell what's worth a closer look,
      the realistic ways to actually sell, and when it's worth grading a card before you sell it at all.
    </p>

    <h2 class="text-3xl">Is Anything Actually Valuable?</h2>
    <p>
      Three things move the needle more than anything else. <strong>Age</strong> matters, but not evenly — genuinely
      vintage cards (mid-century and earlier) tend to hold value simply because fewer of them survived in any
      condition, while a common modern card is rarely worth much regardless of how old it feels to you. <strong>Who's
      on it</strong> matters more than most people expect: a star player, and especially a "rookie card" (a player's
      first officially licensed card, generally the most sought-after card of that player's career), is far more
      likely to carry real value than a random veteran or a team you've never heard of. And <strong>condition</strong>
      is where the loupe look comes in — pull anything promising into good light and look closely, ideally with a
      loupe (a small handheld magnifier collectors use to check a card's surface), at the corners, edges, and
      surface. Sharp corners, no creases, and a clean surface free of scratches or stains are what separate a card
      worth pursuing further from one that's just a card.
    </p>

    <h2 class="text-3xl">Your Options, Ranked by Effort vs. Return</h2>
    <p>
      There's no single right way to sell a collection — it depends on how much time you want to spend versus how
      much of the final sale price you want to keep.
    </p>
    <ul role="list" class="list-disc space-y-3 pl-5">
      <li>
        <strong>Local shop sale</strong> — walk in, get an on-the-spot offer, walk out with cash the same day. It's
        the least effort by far, but the price reflects the fact that the shop still has to resell what they buy from
        you, so it's typically the lowest of these four options. Our{' '}
        <a href="/" class="text-prizm">directory of {stores.length} shops across {cityCount} Canadian cities</a> is a
        good place to find one near you. Shops in our directory that spell out card buying among their services
        include{' '}
        {buyingStores.map((s, i) => (
          <span>
            <a href={`/store/${s.slug}/`} class="text-prizm">{s.name}</a> in{' '}
            <a href={`/${PROVINCES[s.province].slug}/${s.citySlug}/`} class="text-prizm">{s.city}, {s.province}</a>
            {i < buyingStores.length - 1 ? (i === buyingStores.length - 2 ? ', and ' : ', ') : '.'}
          </span>
        ))}
      </li>
      <li>
        <strong>Consignment</strong> — a shop sells your cards on your behalf and takes an agreed cut once they sell,
        rather than buying them from you outright. It usually nets you more than a straight sale since you're not
        selling into the shop's own margin, but it takes longer, since your cards sell at whatever pace the shop's
        customers actually buy them. Not every shop offers it, so ask directly.
      </li>
      <li>
        <strong>Selling it yourself</strong> (eBay or similar) — the highest potential return, since there's no
        middleman taking a cut, but also the most work: photographing each card, writing listings, packing and
        shipping every sale, and handling buyer questions and the occasional return yourself.
      </li>
      <li>
        <strong>A show table</strong> — renting or sharing a table at a{' '}
        <a href="/shows/" class="text-prizm">card show</a> puts you face-to-face with buyers, and whatever sells is
        same-day cash. Weigh the table fee and a full day of your time against it, and know nothing is guaranteed to
        sell — but you'll see in real time what collectors are actually looking for.
      </li>
    </ul>

    <h2 class="text-3xl">Why Sight-Unseen Bulk Offers Run Low</h2>
    <p>
      It's common to get an offer for "the whole box" or "the whole binder" as one flat number, sight unseen. Those
      offers are almost always priced for the worst realistic case — hidden condition problems, mostly low-value
      commons (the everyday cards that make up the bulk of any collection), and nothing genuinely worth a premium
      mixed in — because the buyer has no way to know otherwise until they've sorted it themselves. Doing that
      sorting yourself first, and pulling out anything that actually clears the bar above, usually nets more in
      total than handing over one lump sum for everything unseen. It takes
      longer, but it's the difference between someone else finding the good cards in your collection and you finding
      them yourself. The same logic applies to any "we buy collections" offer that quotes a price before actually
      seeing what's in the box — treat it as a starting point for a conversation, not a final number, and don't feel
      pressured to accept it on the spot.
    </p>

    <h2 class="text-3xl">When Grading First Makes Sense</h2>
    <p>
      Grading (having a third-party company examine a card and seal it in a tamper-evident holder with a numeric
      grade) can raise what a card is worth to a buyer, but it costs money, takes time, and only pays off on cards
      that clear a real value bar to begin with — it isn't worth doing to everything in the box. If you're not sure
      whether a specific card is a candidate, our{' '}
      <a href="/guides/card-grading-101/" class="text-prizm">card grading 101 guide</a> walks through how to decide.
      If you've already decided something's worth submitting and you're doing it from Canada, our{' '}
      <a href="/guides/psa-grading-submissions-canada/" class="text-prizm">PSA submission guide</a> covers the three
      routes collectors here actually use.
    </p>

    <h2 class="text-3xl">Getting Ready to Sell</h2>
    <p>
      However you end up selling, a little prep goes a long way. Sort into rough tiers — obviously worth a closer
      look, maybe, and probably not — so you're not re-evaluating the same pile every time you talk to a buyer. Slide
      anything in the "worth a closer look" pile into a penny sleeve or toploader (a thin plastic sleeve and a rigid
      plastic holder — the standard cheap protection any card shop sells) before it changes hands anywhere, so
      a shop, a show buyer, or a shipping box can't be the thing that knocks a card down a grade. And snap a few
      photos of anything promising before you hand it over — cheap insurance if you ever need to reference its
      condition later. None of this needs to be fancy: a phone camera, a few plastic sleeves from any shop or
      big-box store, and an hour of sorting on a kitchen table is genuinely enough prep for most collections, whether
      you end up selling it all at once or a piece at a time over several months.
    </p>

    {/* CoinMyCard: add a linked entry here once it's out of pre-production — a
        proof-of-possession tool that fits this seller context well. */}
    <CrossLinkCallout
      heading="Getting your cards ready to sell?"
      body="Buyers judge a listing by its photos first — a quick AI enhancement can make your cards look their best before you post or bring them in."
      links={[{ label: 'Make your cards look sharp →', href: 'https://displaymycard.com', external: true }]}
    />

    <p>
      Still not sure what any of it is actually worth? <a href="/guides/how-much-are-my-sports-cards-worth/" class="text-prizm">Our appraisal guide</a> walks through how to size up a collection before you sell.
    </p>

    <section class="mt-12">
      <h2 class="text-2xl">FAQ</h2>
      <dl class="mt-4 space-y-6">
        {faqs.map((faq) => (
          <div>
            <dt class="font-semibold">{faq.question}</dt>
            <dd class="mt-1 max-w-prose text-muted">
              {faq.answer}
              {faq.link !== undefined && (
                <>
                  {' '}
                  <a href={faq.link.href} class="text-prizm">{faq.link.label}</a>
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <p class="text-sm text-muted">
      Not sure where to start, or found a shop that buys collections we're missing? <a href="/suggest/" class="text-prizm">Let us know</a>.
    </p>
  </div>
</Base>
