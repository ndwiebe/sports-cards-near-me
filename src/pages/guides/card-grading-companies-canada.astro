---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import CrossLinkCallout from '../../components/CrossLinkCallout.astro';
import storesJson from '../../data/stores.json';
import type { Store } from '../../lib/types';
import { PROVINCES } from '../../lib/types';
import { absoluteUrl, breadcrumbListLd, byRecommendedRank, faqPageLd, ldJson, type FaqItem } from '../../lib/seo';

const stores = storesJson as Store[];

// Shops that list grading services among what they offer — same computed,
// case-insensitive filter used on the PSA submission guide, so this list
// never drifts out of sync with what's actually in the directory.
const gradingStores2 = stores.filter((s) =>
  s.services.some((v) => v.toLowerCase() === 'grading services'),
);
const gradingStores = [...gradingStores2].sort(byRecommendedRank).slice(0, 3);

// The same shops, all of them, grouped by province for the browsable list below.
// This is the one answer on this page a comparison article cannot copy: every other
// result for "card grading canada" explains the graders, none can tell a Canadian
// which shop down the road will handle the submission. Built from the directory, so
// it follows the daily rebuild instead of going stale in prose.
const gradingByProvince = [...new Set(gradingStores2.map((s) => s.province))]
  .sort((a, b) => PROVINCES[a].name.localeCompare(PROVINCES[b].name))
  .map((code) => ({
    code,
    name: PROVINCES[code].name,
    shops: gradingStores2.filter((s) => s.province === code).sort(byRecommendedRank),
  }));

// Overtime Grading's Balzac, AB drop-off point is also a directory listing —
// looked up by its stable slug rather than hand-typed, same pattern the
// PSA Mississauga guide uses for PSA's own receiving centre.
const overtimeStore = stores.find((s) => s.slug === 'overtime-sports-cards-grading-balzac');
if (overtimeStore === undefined) {
  throw new Error('Overtime Sports Cards & Grading (Balzac) entry missing from stores.json');
}

// Titled for the words people actually type. Search Console, 27 days to
// 2026-08-23: the grading queries are brand-led, and BECKETT is the biggest of
// them (49 impressions across "beckett grading canada", "beckett card grading",
// "beckett grading", "does beckett grade in canada") — while this title said
// only "BGS". A searcher looking for Beckett never saw their own word. Two of
// those queries sit at position 2.0 and 2.6 with zero clicks between them,
// which is a snippet problem, not a ranking one: the 2026-08-25 read found
// guide CTR flat (0.74% -> 0.72%) across five positions of rank improvement.
// Also shorter, so it survives Google's ~60-character cut once the layout
// appends " | Sports Cards Near Me".
const title = 'PSA vs Beckett vs SGC vs CGC: Card Grading in Canada';
// Leads with the brand names and answers the questions the query data actually
// asks — "does beckett grade in canada", "beckett grading canada locations",
// "psa grading cost canada". Every claim here is one the page delivers on.
const description =
  'PSA, Beckett (BGS), SGC and CGC compared for Canadians — which have a Canadian drop-off, which ship across the border, what each costs and how long each takes.';

const capsule =
  "Canadians grading sports cards can use four major US graders — PSA, SGC, CGC, and Beckett (BGS) — plus four Canadian graders that skip the border entirely: Overtime Grading, TGA, KSA, and HOF Grading. PSA carries the strongest resale premium and now has a Mississauga receiving centre; the Canadian graders suit lower-value or bulk submissions where cost and turnaround matter more than resale brand.";

const faqs: FaqItem[] = [
  {
    question: 'Which card grading company should a Canadian collector use?',
    answer:
      "There's no single best answer — it depends on the card. PSA carries the strongest resale premium for modern star cards and now has a Canadian receiving centre in Mississauga. SGC and CGC are well-regarded, especially for vintage. Beckett (BGS) is the only major grader publishing four sub-grades on the label. Canadian graders like Overtime Grading, TGA, KSA, and HOF Grading skip the US cross-border trip entirely, which suits lower-value or bulk cards where resale premium matters less than cost and speed.",
  },
  {
    question: 'How much does card grading cost in Canada?',
    answer:
      "It depends entirely on the grader and the tier of service you pick — faster turnaround always costs more, and the major US graders price in US dollars, so the exchange rate is part of the real cost. Overtime Grading and TGA post CAD pricing directly on their sites; PSA, SGC, CGC, and Beckett publish USD pricing on their own pages. We link every grader's current pricing page below rather than guessing at a number that could be stale by the time you read this.",
  },
  {
    question: 'Is PSA or SGC better for Canadian collectors?',
    answer:
      'Both are reputable US-based graders that Canadians submit to regularly, and both require a cross-border shipment. PSA is the more widely recognized name and tends to carry the strongest resale premium on modern star and rookie cards; SGC has a long history with vintage cards and a devoted following among vintage collectors. Neither is objectively "better" — the right pick depends on the card and what buyers of that specific card tend to pay more for.',
  },
  {
    question: 'Do I pay customs or duties shipping cards to a US grader?',
    answer:
      "Potentially, yes. PSA, SGC, CGC, and Beckett/BGS all grade out of US facilities, so a mailed submission crosses the border twice and can be subject to customs review, duties, or delays either way. PSA's Mississauga receiving centre routes submissions through a bundled customs arrangement that avoids taxing each shipment individually — see our guide to that location for details. SGC, CGC, and Beckett don't currently operate a Canadian receiving centre, so submissions to them ship directly across the border.",
    link: { href: '/guides/psa-grading-mississauga/', label: 'PSA grading drop-off in Mississauga' },
  },
  {
    question: 'Are Canadian card grading companies like TGA, KSA, and Overtime Grading legit?',
    answer:
      "They're real, operating businesses with their own certification numbers, holders, and lookup tools, and each publishes its own pricing and process on its website — we link all of them below. They don't carry the resale-market recognition of PSA, and how much that matters depends entirely on what you're grading: a common modern card sold locally cares a lot less about grader brand than a high-value vintage card being sold to a national market.",
  },
  {
    question: 'How long does card grading take?',
    answer:
      "It varies by grader and by the service tier you choose within that grader — the same company can offer a slow, cheap tier and a fast, expensive one side by side, and posted turnaround times shift with how busy each grader currently is. Check the specific grader's current turnaround before you submit rather than relying on a number that could be out of date.",
  },
];

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: 'Guides', url: absoluteUrl(Astro.site, '/guides/') },
  { name: title, url: absoluteUrl(Astro.site, '/guides/card-grading-companies-canada/') },
]);
const faqLd = faqPageLd(faqs);

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-07-28',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Nathan Wiebe',
    jobTitle: 'Chartered Professional Accountant',
    url: new URL('/about/', Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: 'Sports Cards Near Me' },
};
---
<Base title={`${title} | Sports Cards Near Me`} description={description}>
  <script type="application/ld+json" set:html={ldJson(ld)} />
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  <script type="application/ld+json" set:html={ldJson(faqLd)} />

  <nav class="mt-6 text-sm text-muted"><a href="/guides/" class="hover:text-paper">Guides</a> / {title}</nav>
  <h1 class="mt-3 text-5xl md:text-7xl">Card Grading Companies in Canada, Compared</h1>
  <div class="refractor-rule mt-4 w-28"></div>
  <Byline published="2026-07-28" modified="2026-07-28" />
  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>

  <div class="mt-10 max-w-prose space-y-6 text-paper/90">
    <p class="text-lg">
      There's no single best card grading company for Canadians — the right one depends on the card. PSA carries the
      strongest resale premium for modern star cards and now has a Mississauga receiving centre that skips some
      cross-border friction. SGC and CGC are well-regarded alternatives, especially for vintage. Canadian graders
      like Overtime Grading, TGA, KSA, and HOF Grading avoid the US border trip entirely, which suits lower-value or
      bulk submissions where cost and turnaround matter more than resale-market recognition.
    </p>

    <p>
      This guide compares the graders a Canadian collector can realistically use: what actually differs between
      them, what it costs, how long it takes, and the cross-border friction the US-based graders add that the
      Canadian ones don't. If you've already decided on PSA specifically, our{' '}
      <a href="/guides/psa-grading-submissions-canada/" class="text-prizm">PSA submission guide</a> covers the three
      routes Canadians use to submit, and our{' '}
      <a href="/guides/card-grading-101/" class="text-prizm">card grading 101 guide</a> covers whether a specific
      card is worth grading at all before you pick a grader.
    </p>

    <h2 class="text-3xl">Which Graders Can a Canadian Actually Use?</h2>
    <p>
      Four major graders dominate the hobby: <strong>PSA</strong> (Professional Sports Authenticator),{' '}
      <strong>SGC</strong>, <strong>CGC</strong> (Certified Guaranty Company), and <strong>Beckett Grading
      Services</strong>, often called BGS. All four are US companies with no Canadian grading facility — PSA is the
      exception in that it opened a Canadian <em>receiving centre</em> in Mississauga, Ontario, but the actual
      grading still happens at PSA's US operations. None of SGC, CGC, or Beckett currently publish a Canadian
      receiving location on their own sites.
    </p>
    <p>
      Alongside those four, a handful of Canadian-based graders operate entirely inside the country: <strong>Overtime
      Grading</strong> (Balzac, Alberta), <strong>TGA</strong> (True Grade Authentication, Surrey, British Columbia),{' '}
      <strong>KSA Certification</strong> (Ontario and western Canada offices), and <strong>HOF Grading</strong>{' '}
      (Hall of Fame Card Grading, Toronto-based, mail-in only). None of them carry PSA's resale-market recognition,
      but none of them require a cross-border shipment either.
    </p>

    <h2 class="text-3xl">How Much Does Card Grading Cost in Canada?</h2>
    <p>
      It depends entirely on the grader and the service tier you pick within that grader — slower tiers cost less,
      faster tiers cost more, and every grader adjusts pricing over time. We're not going to print a single "card
      grading costs $X" number here, because it would be wrong for most graders and most cards. Instead, here's
      what's actually posted on each grader's own site as of this writing, with a link to check the current number
      yourself before you submit.
    </p>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-bord text-left text-muted">
            <th class="py-2 pr-4 font-semibold">Grader</th>
            <th class="py-2 pr-4 font-semibold">Based</th>
            <th class="py-2 pr-4 font-semibold">Cheapest tier</th>
            <th class="py-2 pr-4 font-semibold">Fastest tier</th>
            <th class="py-2 pr-4 font-semibold">Best for</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-bord">
          <tr>
            <td class="py-3 pr-4 font-semibold">PSA</td>
            <td class="py-3 pr-4">US grading; Mississauga, ON receiving centre</td>
            <td class="py-3 pr-4">
              See <a href="https://www.psacard.com/pricing" target="_blank" rel="noopener" class="text-prizm">PSA's pricing page</a>
            </td>
            <td class="py-3 pr-4">
              See <a href="https://www.psacard.com/pricing" target="_blank" rel="noopener" class="text-prizm">PSA's pricing page</a>
            </td>
            <td class="py-3 pr-4">Modern star/rookie cards where resale premium matters most</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">SGC</td>
            <td class="py-3 pr-4">US grading only</td>
            <td class="py-3 pr-4">
              See <a href="https://gosgc.com/" target="_blank" rel="noopener" class="text-prizm">SGC's site</a>
            </td>
            <td class="py-3 pr-4">
              See <a href="https://gosgc.com/" target="_blank" rel="noopener" class="text-prizm">SGC's site</a>
            </td>
            <td class="py-3 pr-4">Vintage cards, where SGC has a strong following</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">CGC Cards</td>
            <td class="py-3 pr-4">US grading only</td>
            <td class="py-3 pr-4">$17 USD/card (Bulk, ≤$500 value, 150 business days, 25-card min.)</td>
            <td class="py-3 pr-4">$300 USD/card (WalkThrough, 2 business days)</td>
            <td class="py-3 pr-4">TCG crossover collectors already inside CGC's registry ecosystem</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">Beckett (BGS)</td>
            <td class="py-3 pr-4">US grading only</td>
            <td class="py-3 pr-4">$14.95 USD/card (Base, 75+ business days, no subgrades)</td>
            <td class="py-3 pr-4">$124.95 USD/card (Priority, 5 business days)</td>
            <td class="py-3 pr-4">Collectors who want all four sub-grades printed on the label</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">Overtime Grading</td>
            <td class="py-3 pr-4">Balzac, AB (Canadian)</td>
            <td class="py-3 pr-4">$15 CAD/card (Bronze, 30 business days; $12/card at 100+ bulk)</td>
            <td class="py-3 pr-4">$25 CAD/card (Gold, 5 business days)</td>
            <td class="py-3 pr-4">Canadians who want CAD pricing and no border crossing</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">TGA</td>
            <td class="py-3 pr-4">Surrey, BC (Canadian)</td>
            <td class="py-3 pr-4">$15/card (Value, 15-card min.)</td>
            <td class="py-3 pr-4">$50/card (Same Day, by appointment)</td>
            <td class="py-3 pr-4">Pokémon/TCG alongside sports cards, in one Canadian submission</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">KSA Certification</td>
            <td class="py-3 pr-4">Ontario + western Canada offices</td>
            <td class="py-3 pr-4">$15/card (Bulk, 100+ cards, ~40 business days)</td>
            <td class="py-3 pr-4">$150/card (Walk Through, same day, Ontario office only)</td>
            <td class="py-3 pr-4">Large bulk submissions on a budget</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-semibold">HOF Grading</td>
            <td class="py-3 pr-4">Toronto, ON (Canadian, mail-in)</td>
            <td class="py-3 pr-4">$10/card (180-day tier, sale pricing at time of writing)</td>
            <td class="py-3 pr-4">$30/card (3-day tier, sale pricing at time of writing)</td>
            <td class="py-3 pr-4">Budget grading on a long timeline, all-Canadian</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-muted">
      Prices and turnaround times verified directly against each grader's own site on 2026-07-28 and change often —
      confirm the current number on the grader's site before you submit. CGC, Beckett, Overtime Grading, TGA, and KSA
      figures above are quoted exactly as posted; PSA and SGC don't publish a stable per-card figure we could quote
      with confidence, so we link straight to their pricing pages instead.
    </p>

    <h2 class="text-3xl">Is PSA or SGC Better for Canadian Collectors?</h2>
    <p>
      Both are reputable, both are US-based, and both mean a cross-border shipment either way. PSA is the more
      widely recognized name in the hobby and tends to carry the strongest resale premium on modern star and rookie
      cards — buyers pay more, on average, for a PSA-graded copy of the same card versus an equivalent grade from
      another company. SGC has a long history and a loyal following specifically among vintage collectors, where its
      black-bordered holder is a familiar, trusted sight. Neither is "better" in general; the right pick depends on
      what buyers of your specific card actually favor.
    </p>

    <h2 class="text-3xl">Do I Pay Customs Shipping Cards to a US Grader?</h2>
    <p>
      Potentially, yes — SGC, CGC, and Beckett all grade exclusively at US facilities, so a mailed submission from
      Canada crosses the border twice, with the customs paperwork, duty exposure, and cross-border shipping cost
      that implies. PSA is the one exception: its Mississauga, Ontario receiving centre routes Canadian submissions
      through a bundled customs arrangement instead of taxing each shipment individually, which is a genuinely
      different experience than mailing cards straight to the US. Our{' '}
      <a href="/guides/psa-grading-mississauga/" class="text-prizm">guide to that location</a> covers the address,
      hours, and how in-person drop-off works. The four Canadian graders below skip this question entirely — nothing
      leaves the country.
    </p>

    <h2 class="text-3xl">Are Canadian Grading Companies Like TGA, KSA, and Overtime Grading Legit?</h2>
    <p>
      Yes, in the sense that they're real, operating businesses with their own certification numbers, tamper-evident
      holders, and online cert-lookup tools — we've linked each one's actual site and pricing above rather than
      taking their word for it. What they don't carry is PSA's decades of resale-market recognition, so a Canadian-
      graded card may sell for less on the open market than an identical card in a PSA holder, purely on brand
      recognition rather than actual condition. Whether that gap matters to you depends on what you're grading and
      why:
    </p>
    <ul role="list" class="list-disc space-y-2 pl-5">
      <li>
        <strong>Overtime Grading</strong> (Balzac, Alberta) posts CAD pricing directly on its site — $15/$20/$25 CAD
        per card across three turnaround tiers (30/15/5 business days), with bulk discounts at 100+ cards. It
        operates out of the same New Horizon Mall location listed in our directory as{' '}
        <a href={`/store/${overtimeStore.slug}/`} class="text-prizm">{overtimeStore.name}</a>, so Albertans can
        drop cards off in person.
      </li>
      <li>
        <strong>TGA</strong> (Surrey, British Columbia) grades sports cards and TCG cards side by side, with tiers
        from $15/card (15-card minimum) up to $50/card same-day grading by appointment. Its own FAQ notes turnaround
        can extend beyond its stated target during high-volume stretches — check tgagrading.com for the current
        estimate before submitting.
      </li>
      <li>
        <strong>KSA Certification</strong> has operated since 1996 out of an Ontario office and a separate western
        Canada office, with published tiers running from same-day "Walk Through" service at $150/card down to
        $15/card for 100+ card bulk submissions.
      </li>
      <li>
        <strong>HOF Grading</strong> (Toronto) is a mail-in-only Canadian grader with tiers from a 180-day budget
        option up to a 3-day rush option; current pricing on its site is discounted from posted regular prices,
        which is worth confirming still applies before you submit.
      </li>
    </ul>

    <h2 class="text-3xl">What About Grading Through a Local Shop?</h2>
    <p>
      A number of shops in our directory offer grading services of their own: they take your cards in person and
      handle the submission — usually to PSA — on your behalf, which takes the cross-border shipping question off
      your plate entirely. Shops that currently list grading services include{' '}
      {gradingStores.map((s, i) => (
        <span>
          <a href={`/store/${s.slug}/`} class="text-prizm">{s.name}</a> in{' '}
          <a href={`/${PROVINCES[s.province].slug}/${s.citySlug}/`} class="text-prizm">{s.city}, {s.province}</a>
          {i < gradingStores.length - 1 ? (i === gradingStores.length - 2 ? ', and ' : ', ') : '.'}
        </span>
      ))}
      {' '}Our{' '}
      <a href="/guides/psa-grading-submissions-canada/" class="text-prizm">PSA submission guide</a> covers that route
      in full, alongside submitting direct and group submissions.
    </p>
    <p>
      Here is every shop in the directory that lists grading services, by province — {gradingStores2.length} of
      them. Being listed here is free and nobody paid to appear; it reflects what each shop says it offers.
      Confirm the details with the shop before you hand over cards, because which grader they submit to, what
      they charge on top, and how often they ship all vary.
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {gradingByProvince.map((group) => (
        <div>
          <h3 class="font-semibold uppercase tracking-wide text-muted">{group.name}</h3>
          <ul role="list" class="mt-2 space-y-1 text-sm">
            {group.shops.map((s) => (
              <li>
                <a href={`/store/${s.slug}/`} class="text-prizm">{s.name}</a>{' '}
                <span class="text-muted">— {s.city}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <h2 class="text-3xl">How Long Does Card Grading Take?</h2>
    <p>
      It varies by grader and, within a single grader, by the tier you pick — the same company can run a slow,
      cheap tier and a fast, expensive one side by side, and posted turnaround times shift with how busy each
      grader currently is. CGC's own site currently posts anywhere from 2 business days (WalkThrough) to 150
      business days (Bulk); Beckett posts 5 to 75+ business days across its four tiers. The Canadian graders above
      run their own separate timelines, usually faster for a simple reason: cards aren't crossing a border twice.
      Check the specific grader's current turnaround before you submit — none of these numbers are fixed.
    </p>

    <h2 class="text-3xl">Which Grader Fits Which Situation</h2>
    <p>
      If you're grading a modern star or rookie card and resale value depends on maximum brand recognition, PSA is
      the name buyers pay the most for — worth the border trip, and Mississauga now shortens that trip for
      Canadians. If vintage is your focus and the card's era matters more than the grading brand, SGC's long
      vintage-collector following makes it a reasonable alternative worth pricing out alongside PSA. If you're
      grading a stack of modern bulk or lower-value cards where a resale premium wouldn't cover the extra cost and
      hassle of a US grader, one of the Canadian options — Overtime Grading, TGA, or KSA's bulk tiers — usually
      makes more financial sense. And if you'd rather not handle shipping or paperwork at all, a local shop that
      offers grading services does that work for you.
    </p>

    <CrossLinkCallout
      heading="Selling graded cards as a business?"
      body="If you're buying, grading, and reselling cards as a business, proper bookkeeping and tax planning are worth getting right — built specifically for card dealers."
      links={[{ label: 'Tax help for card dealers →', href: 'https://slabsavvycpa.com', external: true }]}
    />

    <h2 class="text-3xl">Deciding Whether to Grade at All</h2>
    <p>
      Picking a grader only matters once you've decided a specific card is actually worth grading in the first
      place — submission fees, shipping, and insurance only pay for themselves on cards with real value gap between
      raw and graded. Our{' '}
      <a href="/guides/card-grading-101/" class="text-prizm">card grading 101 guide</a> walks through that decision.
      And if you're weighing grading against simply selling a collection as-is, our{' '}
      <a href="/sell/" class="text-prizm">sell your cards hub</a> covers where Canadian shops buy collections,
      by city.
    </p>

    <p class="text-sm text-muted">
      Prices, turnaround times, and grader details change — if something here is out of date, or a Canadian grader
      we should add or remove, <a href="/suggest/" class="text-prizm">let us know</a>.
    </p>
  </div>
</Base>
