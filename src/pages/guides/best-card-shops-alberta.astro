---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import storesJson from '../../data/stores.json';
import showsJson from '../../data/shows.json';
import type { Store } from '../../lib/types';
import { PROVINCES } from '../../lib/types';
import { isBuyer } from '../../lib/sell';
import { isPokemonShop } from '../../lib/tcg';
import type { ShowRecord } from '../../lib/shows';
import { primaryShowCalendarYear, showsInProvinceYear, isUpcoming } from '../../lib/shows';
import {
  MIN_REVIEWS_FOR_TOP,
  bySportsCardRank,
  absoluteUrl,
  breadcrumbListLd,
  faqPageLd,
  ldJson,
  type FaqItem,
} from '../../lib/seo';

const stores = storesJson as Store[];
const abStores = stores.filter((s) => s.province === 'AB');
const abRated = abStores.filter((s) => s.rating !== undefined);
const cityCount = new Set(abStores.map((s) => s.citySlug)).size;
const provinceSlug = PROVINCES.AB.slug;
const gradingStoreCount = abStores.filter((s) => s.services.some((v) => v.toLowerCase() === 'grading services')).length;

// Alberta's show-calendar link, computed the same way the province page does
// (primaryShowCalendarYear): the /shows/[provinceYear]/ route is generated
// purely from shows.json, so a hardcoded year 404s once that year's show
// passes out of the data. Renders nothing if Alberta has no shows tracked at
// all; the wording only says "upcoming" when that year actually has one.
const shows = showsJson as ShowRecord[];
const buildDate = new Date();
const showYear = primaryShowCalendarYear(shows, 'AB', buildDate);
const showsUrl = showYear !== undefined ? `/shows/${provinceSlug}-${showYear}/` : undefined;
const showYearHasUpcoming =
  showYear !== undefined && showsInProvinceYear(shows, 'AB', showYear).some((s) => isUpcoming(s, buildDate));

function joinWithAnd(items: string[]): string {
  if (items.length === 0) return '';
  if (items.length === 1) return items[0]!;
  if (items.length === 2) return `${items[0]} and ${items[1]}`;
  return `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
}
function namesList(shops: Store[]): string {
  const names = shops.map((s) => s.name);
  if (names.length <= 3) return joinWithAnd(names);
  const shown = names.slice(0, 3);
  return `${shown.join(', ')}, and ${names.length - shown.length} more`;
}

// Top Alberta shops by the directory-wide weighted score — computed at build time
// from stores.json, never hand-typed, so this list can't go stale-wrong: it simply
// reflects whatever the directory's live data says.
// Only shops with at least MIN_REVIEWS_FOR_TOP reviews are eligible: a 5.0 rating
// from a couple of reviews shouldn't outrank a shop with a real review history.
// Sorted by raw rating until 2026-08-01, which put this page out of step with the
// volume weighting every other ranked surface had already adopted.
const topEligible = abRated.filter((s) => (s.reviewCount ?? 0) >= MIN_REVIEWS_FOR_TOP);
const topShops = [...topEligible].sort(bySportsCardRank).slice(0, 8);
const topCityCount = new Set(topShops.map((s) => s.citySlug)).size;
const mostReviewed = [...topShops].sort((a, b) => (b.reviewCount ?? 0) - (a.reviewCount ?? 0))[0];

const buyers = abStores.filter(isBuyer);
const pokemonShops = abStores.filter(isPokemonShop);
const topFirst = topShops[0];

const title = 'Best Card Shops in Alberta';
const description =
  "Alberta's highest-ranked sports card shops, ordered by a weighted score that counts review volume alongside the star average.";
const pagePath = '/guides/best-card-shops-alberta/';

const capsule =
  mostReviewed !== undefined
    ? `Alberta has ${abStores.length} sports card shops listed on Sports Cards Near Me across ${cityCount} cities, and ${topEligible.length} of them clear our ${MIN_REVIEWS_FOR_TOP}-review bar. The ${topShops.length} highest-ranked are listed here. ${mostReviewed.name} in ${mostReviewed.city} leads that group on review volume, at ${mostReviewed.reviewCount} Google reviews.`
    : `Alberta has ${abStores.length} sports card shops listed on Sports Cards Near Me across ${cityCount} cities. None currently carry enough Google reviews to clear our ${MIN_REVIEWS_FOR_TOP}-review bar for a ranked "best" list, so this page lists what we have and explains why.`;

const faqs: FaqItem[] = [
  {
    question: 'How many card shops are in Alberta?',
    answer: `${abStores.length} sports card shops are listed across ${cityCount} Alberta cities on Sports Cards Near Me, and ${topEligible.length} of them meet our ${MIN_REVIEWS_FOR_TOP}-review bar for a "best" ranking. The ${topShops.length} highest-ranked appear on this page.`,
    link: { href: `/${provinceSlug}/`, label: 'Full Alberta directory' },
  },
  topFirst !== undefined
    ? {
        question: 'Which Alberta card shop ranks first?',
        answer: `${topFirst.name} in ${topFirst.city} currently ranks first among Alberta shops that clear our review bar, at ${topFirst.rating} stars from ${topFirst.reviewCount} Google reviews.`,
        link: { href: `/store/${topFirst.slug}/`, label: `See ${topFirst.name}'s listing` },
      }
    : {
        question: 'Which Alberta card shop ranks first?',
        answer: `No Alberta shop currently has ${MIN_REVIEWS_FOR_TOP} or more reviews behind its rating, so we aren't naming a top pick yet.`,
      },
  buyers.length > 0
    ? {
        question: 'Do Alberta card shops buy collections?',
        answer: `Yes — ${namesList(buyers)} ${buyers.length === 1 ? 'lists' : 'list'} buying collections as a service across the province.`,
        link: { href: '/sell/', label: 'Shops that buy collections' },
      }
    : {
        question: 'Do Alberta card shops buy collections?',
        answer: 'None of the Alberta shops listed here currently advertise buying collections as a service. Check our sell hub for shops that do buy in other provinces.',
        link: { href: '/sell/', label: 'Browse shops that buy collections' },
      },
  pokemonShops.length > 0
    ? {
        question: 'Do Alberta card shops sell Pokémon cards?',
        answer: `Yes — ${namesList(pokemonShops)} ${pokemonShops.length === 1 ? 'carries' : 'carry'} Pokémon cards in Alberta.`,
        link: { href: '/pokemon/', label: 'Browse Pokémon shops' },
      }
    : {
        question: 'Do Alberta card shops sell Pokémon cards?',
        answer: 'None of the Alberta shops listed here currently tag Pokémon in their catalog.',
      },
  {
    question: 'Do any Alberta card shops offer grading services?',
    answer:
      gradingStoreCount > 0
        ? `${gradingStoreCount} Alberta ${gradingStoreCount === 1 ? 'shop lists' : 'shops list'} grading services among what they offer.`
        : "None of the Alberta shops listed here currently advertise grading services as a confirmed offering. That's a gap in what we've verified, not proof no shop does it.",
    link: { href: '/guides/card-grading-companies-canada/', label: "Compare Canada's grading companies" },
  },
];

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: absoluteUrl(Astro.site, '/') },
  { name: 'Guides', url: absoluteUrl(Astro.site, '/guides/') },
  { name: title, url: absoluteUrl(Astro.site, pagePath) },
]);
const faqLd = faqPageLd(faqs);

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL('/images/guide-best-alberta.webp', Astro.site).href,
  datePublished: '2026-07-11',
  dateModified: '2026-07-11',
  author: {
    '@type': 'Person',
    name: 'Nathan Wiebe',
    jobTitle: 'Chartered Professional Accountant',
    url: new URL('/about/', Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: 'Sports Cards Near Me' },
};
---
<Base title={`${title} | Sports Cards Near Me`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  <script type="application/ld+json" set:html={ldJson(faqLd)} />

  <section class="relative mt-6 overflow-hidden rounded-2xl border border-bord bg-panel">
    <img
      src="/images/guide-best-alberta.webp"
      srcset="/images/guide-best-alberta@900.webp 900w, /images/guide-best-alberta.webp 1600w"
      sizes="(max-width: 900px) 100vw, 1024px"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/25"></div>
    <div class="relative px-6 py-10 md:px-12 md:py-14">
      <nav class="text-sm text-muted"><a href="/guides/" class="hover:text-paper">Guides</a> / {title}</nav>
      <h1 class="mt-3 text-5xl md:text-7xl">{title}</h1>
      <div class="refractor-rule mt-4 w-28"></div>
  <Byline published="2026-07-11" modified="2026-07-11" />
    </div>
  </section>

  <p class="mt-4 max-w-prose text-paper/85" data-answer-capsule>{capsule}</p>

  <div class="mt-10 max-w-prose space-y-6 text-paper/90">
    <p>
      Alberta has one of the deepest sports card scenes in our directory: {abStores.length} shops spread across{' '}
      {cityCount} cities, from big-city storefronts to small-town spots that have been buying, selling, and trading
      cards for years. Instead of picking favorites ourselves, we pulled the numbers straight from our own listings —
      every Alberta shop's public Google rating and review count — and ranked them the same way for every shop.
      Here's what came out on top, and how to make the most of it once you've picked a shop to visit.
    </p>

    <h2 class="text-3xl">How We Ranked These Shops</h2>
    <p>
      Of the {abStores.length} Alberta shops in our directory, {abRated.length} carry a public Google rating, and
      {topEligible.length} of those have at least {MIN_REVIEWS_FOR_TOP} reviews behind that rating — the bar a shop
      has to clear before it can land on this list. A perfect rating from just a review or two is too easy to fluke,
      so shops below that bar are still in our directory, just not crowned here. Among the shops that clear it, we
      don't rank on the star average alone. How many people left a review counts as evidence in its own right, so a
      4.7 backed by hundreds of collectors places above a 5.0 backed by twenty — the bigger number is the harder one
      to fake and the one more people have actually tested. Rating still separates shops with similar review counts.
      This list is generated straight from that data rather than hand-picked, so it updates the same way our
      directory does. No shop here got a mention it didn't earn, and none of them paid for a place on this list. The
      honest limitation: a genuinely excellent shop that simply hasn't been reviewed much yet will sit lower than it
      deserves, so a shop just off this list is worth a look — the{' '}
      <a href={`/${provinceSlug}/`} class="text-prizm">full Alberta directory</a> shows every shop's numbers side by
      side.
    </p>

    <h2 class="text-3xl">What "Top" Means Here</h2>
    <p>
      A ranking like this reflects reputation, not inventory. We're not weighing how many cards a shop stocks, how
      big the store is, or what sports it focuses on, since we don't have consistent inventory details across every
      Alberta shop yet. What we do have is a rating and a review count for most of them, and that's an honest,
      apples-to-apples way to compare reputation across a province this size, whether a shop is a single storefront
      in a small town or a bigger operation in one of the bigger cities.
    </p>

    <h2 class="text-3xl">The Highest-Ranked Card Shops in Alberta</h2>
    <ol role="list" class="space-y-3">
      {topShops.map((s, i) => (
        <li class="rounded-xl border border-bord bg-panel p-4">
          <a href={`/store/${s.slug}/`} class="text-xl font-semibold hover:text-prizm">{i + 1}. {s.name}</a>
          <p class="mt-1 text-sm text-muted">
            <a href={`/${provinceSlug}/${s.citySlug}/`} class="hover:text-paper">{s.city}, AB</a>
            {s.rating !== undefined && (
              <span class="text-gold">
                {' '}· ★ {s.rating}
                {s.reviewCount !== undefined && <span class="text-muted"> ({s.reviewCount} Google {s.reviewCount === 1 ? 'review' : 'reviews'})</span>}
              </span>
            )}
          </p>
        </li>
      ))}
    </ol>
    <p>
      Between them, these {topShops.length} shops span {topCityCount} different Alberta cities, so there's a decent
      chance one of them isn't far from you.
    </p>

    <h2 class="text-3xl">Reading the Ratings</h2>
    <p>
      A perfect rating means everyone who's left a review walked away happy, but it's worth reading the review count
      alongside the rating rather than the rating on its own.{' '}
      {mostReviewed !== undefined && (
        <>
          <a href={`/store/${mostReviewed.slug}/`} class="text-prizm">{mostReviewed.name}</a>, for example, carries a{' '}
          {mostReviewed.rating} rating from {mostReviewed.reviewCount} Google reviews — the most of any shop on this
          list, and a different kind of signal than a shop sitting at the same rating with only a couple of reviews
          behind it.{' '}
        </>
      )}
      Both are genuinely strong, but more reviews means more collectors vouching for a shop across more visits.
      Neither number tells you what's actually in the cases, or whether a shop leans hockey, Pokémon, or vintage, so
      it's worth calling ahead or checking a shop's own page before making a special trip, especially if you're
      driving in from out of town.
    </p>

    <h2 class="text-3xl">What These Shops Have in Common</h2>
    <p>
      Most of the shops in our Alberta directory are small, independently run operations, and only a handful spell
      out extras like card grading, box breaks (group openings of sealed boxes), or trade nights in what they list
      with us. That's a gap in what
      we've verified so far rather than a sign those shops don't offer that — plenty of local shops run these kinds
      of extras without ever putting them on paper anywhere online. If you know a shop that does something worth
      mentioning, that's exactly the kind of detail we're trying to fill in as we verify more of the province. In
      the meantime, the surest way to find out what a shop actually stocks, whether they buy collections, or when
      they're really open is to reach out directly before you make the trip.
    </p>

    <h2 class="text-3xl">Before You Go</h2>
    <p>
      A few things are worth checking no matter which shop you're headed to. Hours at small, independently run shops
      can drift from whatever's posted online, especially outside the bigger cities, so a quick call or message
      ahead confirms you're not driving out to a locked door. If you're hoping to sell or trade rather than just buy,
      ask what a shop is looking for before you show up — some shops buy collections outright, others prefer
      straight trades, and most would rather know in advance than sort through a box cold. And if you're chasing
      something specific, whether it's a particular set, a player, or a sport, a quick message with your want list
      often saves everyone a wasted trip.
    </p>

    <h2 class="text-3xl">Beyond the Top {topShops.length}</h2>
    <p>
      These {topShops.length} rank highest in our Alberta directory as it stands today, but they're
      far from the only ones worth a visit. Alberta has card shops spread across {cityCount} different cities in our
      listings, and that list keeps growing as we verify more of the country. Browse the{' '}
      <a href={`/${provinceSlug}/`} class="text-prizm">full Alberta directory</a> to see every shop we've mapped near
      you, or see how Calgary and Edmonton specifically stack up in our{' '}
      <a href="/guides/best-card-shops-calgary/" class="text-prizm">Calgary</a> and{' '}
      <a href="/guides/best-card-shops-edmonton/" class="text-prizm">Edmonton</a> guides. If you're weighing whether a
      card is worth grading before you sell or trade it at one of these shops, our{' '}
      <a href="/guides/card-grading-101/" class="text-prizm">card grading 101 guide</a> covers that decision.
      {showsUrl !== undefined && (
        <>
          {' '}Alberta's{' '}
          <a href={showsUrl} class="text-prizm">
            {showYearHasUpcoming ? `upcoming ${showYear} card show calendar` : `${showYear} card show calendar`}
          </a>{' '}
          is another way to see a lot of dealers in one place.
        </>
      )}
    </p>

    <section class="mt-12">
      <h2 class="text-2xl">FAQ</h2>
      <dl class="mt-4 space-y-6">
        {faqs.map((faq) => (
          <div>
            <dt class="font-semibold">{faq.question}</dt>
            <dd class="mt-1 max-w-prose text-muted">
              {faq.answer}
              {faq.link !== undefined && (
                <>
                  {' '}
                  <a href={faq.link.href} class="text-prizm">{faq.link.label}</a>
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <p class="text-sm text-muted">
      Ratings and review counts shift as new collectors leave feedback, and shops open, close, or change hands over
      time, so this list will look a little different the next time we regenerate it. Know a shop in Alberta we're
      missing, or something here looks out of date? <a href="/suggest/" class="text-prizm">Let us know</a> and we'll
      get it added or corrected.
    </p>
  </div>
</Base>
