---
interface CrossLinkItem {
  label: string;
  href: string;
  external: boolean;
}

interface Props {
  heading: string;
  body: string;
  links: CrossLinkItem[];
}

const { heading, body, links } = Astro.props;
---
<aside class="mt-10 rounded-xl border border-bord bg-panel p-5 md:p-6">
  <div class="border-l-2 border-prizm pl-4">
    <p class="font-display text-base uppercase tracking-wide text-prizm">{heading}</p>
    <p class="mt-2 max-w-prose text-sm text-paper/85">{body}</p>
    <ul role="list" class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      {links.map((link) => (
        <li>
          {link.external ? (
            <a href={link.href} target="_blank" rel="noopener" class="text-sm font-semibold text-prizm hover:underline">
              {link.label}
            </a>
          ) : (
            <a href={link.href} class="text-sm font-semibold text-prizm hover:underline">
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</aside>
