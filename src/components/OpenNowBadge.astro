---
import type { Store } from '../lib/types';
import { openNowPayload } from '../lib/open-now';

interface Props { store: Store }
const { store } = Astro.props;

// undefined covers both an unparseable hours string (all-or-nothing, see
// store-hours.ts) and a closed/online-only shop (no current walk-in location
// to be "open" at) — either way the badge renders nothing, never a guess.
const payload = openNowPayload(store);
const json = payload !== undefined ? JSON.stringify(payload).replace(/</g, '\\u003c') : undefined;
---
{payload !== undefined && (
  <span data-open-now class="mt-1 block text-sm font-semibold">
    <script type="application/json" data-open-now-spec set:html={json} />
  </span>
)}
<script>
  import { computeOpenState } from '../lib/open-now';
  import type { OpeningHoursSpecification } from '../lib/store-hours';

  interface Payload { spec: OpeningHoursSpecification[]; timeZone: string }

  // Deliberately client-side only — see open-now.ts for why. Not scoped to a
  // single badge: Astro dedupes this script to one copy per page regardless
  // of how many StoreCards render it, so it has to sweep every badge itself.
  for (const el of document.querySelectorAll<HTMLElement>('[data-open-now]')) {
    const raw = el.querySelector('script[data-open-now-spec]')?.textContent;
    if (raw === undefined || raw === null || raw === '') continue;
    const { spec, timeZone } = JSON.parse(raw) as Payload;
    const state = computeOpenState(spec, timeZone, new Date());
    el.textContent = state.summary;
    el.classList.add(state.isOpen ? 'text-emerald-400' : 'text-rose-300');
  }
</script>
