---
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
const height = Math.round((size / 24) * 30);
---
<svg width={size} height={height} viewBox="0 0 24 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="mark-refractor" x1="0" y1="0" x2="1" y2=".35">
      <stop offset="0" stop-color="#5AD7FF" />
      <stop offset=".34" stop-color="#907CFF" />
      <stop offset=".68" stop-color="#FF7FB2" />
      <stop offset="1" stop-color="#FFC46B" />
    </linearGradient>
  </defs>
  <rect x="3.5" y="4" width="17" height="22" rx="2.5" fill="url(#mark-refractor)" />
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    fill="currentColor"
    d="M5 1 h14 a3 3 0 0 1 3 3 v22 a3 3 0 0 1 -3 3 H5 a3 3 0 0 1 -3 -3 V4 a3 3 0 0 1 3 -3 Z M12 7.2 c-3 0 -5.4 2.4 -5.4 5.4 c0 4 5.4 9.6 5.4 9.6 s5.4 -5.6 5.4 -9.6 c0 -3 -2.4 -5.4 -5.4 -5.4 Z"
  />
</svg>
