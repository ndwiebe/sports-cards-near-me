---
import type { Store } from '../lib/types';
import type { MapStore } from '../lib/map-data';
import { toMapStores } from '../lib/map-data';
import logoSlugs from '../data/logos.json';
import '../styles/map.css';

interface Props {
  stores: Store[];
  mode: 'home' | 'city' | 'store';
  height?: string;
  extra?: MapStore[] | undefined;
}
const { stores, mode, height, extra } = Astro.props;
const payload = JSON.stringify([
  ...toMapStores(stores, new Set(logoSlugs as string[])),
  ...(extra ?? []),
]).replace(/</g, '\\u003c');
---
<div class="map-shell" data-map-mode={mode} style={height !== undefined ? `height:${height}` : undefined}>
  <script type="application/json" data-map-stores set:html={payload} />
  <p class="map-fallback p-6 text-sm text-muted">
    The interactive map needs JavaScript (and a map key) — every store below is fully browsable without it.
  </p>
</div>
<script>
  import { mountMap } from '../scripts/map-core';
  import { registerMap } from '../scripts/map-registry';
  import type { MapStore } from '../lib/map-data';

  async function mountShell(shell: HTMLElement): Promise<void> {
    if (shell.dataset['mapState'] !== undefined) return;
    shell.dataset['mapState'] = 'loading';
    const raw = shell.querySelector('script[data-map-stores]')?.textContent ?? '[]';
    const stores = JSON.parse(raw) as MapStore[];
    const mode = shell.dataset['mapMode'];
    let handle;
    try {
      handle = await mountMap(
        shell,
        stores,
        mode === 'store' ? { zoom: 14, pitch: 60 } : mode === 'home' ? { pitch: 34 } : {},
      );
    } catch {
      // Deferred chunk failed to download — collapse to the fallback text
      // rather than shimmering forever.
      shell.dataset['mapState'] = 'off';
      shell.style.removeProperty('height');
      return;
    }
    if (!handle) return;
    handle.onPinClick((slug) => {
      const entry = stores.find((s) => s.slug === slug);
      const isReseller = entry?.kind === 'reseller';
      const card = document.querySelector(
        isReseller ? `[data-reseller-card="${slug}"]` : `[data-store-card="${slug}"]`,
      );
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('ring-2', 'ring-prizm');
        setTimeout(() => card.classList.remove('ring-2', 'ring-prizm'), 1800);
      } else {
        window.location.href = isReseller ? `/resellers/${slug}/` : `/store/${slug}/`;
      }
    });
    registerMap(shell, handle);
  }

  // Mapbox is ~490 KB, so it mounts only once the shell starts entering the
  // viewport — the initial paint never waits on it. No lookahead margin: on a
  // phone the home map sits 35px below the fold, and any margin that reaches
  // it re-joins Mapbox to the load window and gives back the LCP win; the
  // loading scenery covers the beat between scroll and mount. A shell hidden
  // behind the mobile List/Map toggle intersects the moment the toggle
  // reveals it, so no extra wiring there. Without a token mountMap collapses
  // the shell to the fallback text; do that immediately rather than as it
  // scrolls into view.
  const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;
  for (const shell of document.querySelectorAll<HTMLElement>('.map-shell')) {
    if (token === undefined || token === '' || !('IntersectionObserver' in window)) {
      void mountShell(shell);
      continue;
    }
    const io = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        void mountShell(entry.target as HTMLElement);
      }
    });
    io.observe(shell);
  }
</script>
