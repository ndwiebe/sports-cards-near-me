{
  // Template only — never deployed directly. The KV namespace ID doesn't exist until
  // the deploy workflow creates or looks it up, so __KV_ID__ is filled in at deploy
  // time into a generated copy. See .github/workflows/deploy-click-tracker.yml.
  "name": "scnm-click-tracker",
  "main": "click-tracker.js",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    { "binding": "CLICKS", "id": "__KV_ID__" }
  ]
}
